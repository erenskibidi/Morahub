-- Hook Raycast / FindPartOnRay (súng dùng raycast) và Mouse.Hit / Mouse.Target (súng dùng chuột)
pcall(function()
	if not (hookmetamethod and getnamecallmethod and checkcaller) then
		warn("[AutoFarm] Executor không hỗ trợ hookmetamethod, Silent Aim sẽ không hoạt động")
		return
	end

	local oldNamecall
	oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		local method = getnamecallmethod()
		if currentTarget and self == workspace and not checkcaller() then
			if method == "Raycast" then
				local args = table.pack(...)
				if typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
					args[2] = (currentTarget.Position - args[1]).Unit * args[2].Magnitude
					return oldNamecall(self, table.unpack(args, 1, args.n))
				end
			elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
				local args = table.pack(...)
				local ray = args[1]
				if typeof(ray) == "Ray" then
					args[1] = Ray.new(ray.Origin, (currentTarget.Position - ray.Origin).Unit * ray.Direction.Magnitude)
					return oldNamecall(self, table.unpack(args, 1, args.n))
				end
			end
		end
		return oldNamecall(self, ...)
	end))

	local oldIndex
	oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
		if currentTarget and self == Mouse and not checkcaller() then
			if key == "Hit" then
				return currentTarget.CFrame
			elseif key == "Target" then
				return currentTarget
			end
		end
		return oldIndex(self, key)
	end))
end)

-- ==================== NO RECOIL ====================
-- Quét các bảng cấu hình súng trong bộ nhớ (getgc), tìm trường có chữ "recoil"
-- rồi nhân với recoilScale (0 = không giật). Lưu giá trị gốc để khôi phục khi tắt.
local noRecoil = {
	enabled = false,
	scale = 0,
}

local recoilOriginal = setmetatable({}, { __mode = "k" }) -- [table] = { [key] = giá trị gốc }

local function applyRecoil(scale)
	if not getgc then
		return
	end
	local ok, objects = pcall(getgc, true)
	if not ok then
		return
	end
	for _, obj in ipairs(objects) do
		if type(obj) == "table" and not (isreadonly and isreadonly(obj)) then
			pcall(function()
				for key, value in pairs(obj) do
					if type(key) == "string" and type(value) == "number" and key:lower():find("recoil") then
						local saved = recoilOriginal[obj]
						if not saved then
							saved = {}
							recoilOriginal[obj] = saved
						end
						if saved[key] == nil then
							saved[key] = value
						end
						rawset(obj, key, saved[key] * scale)
					end
				end
			end)
		end
	end
end

local function restoreRecoil()
	for obj, saved in pairs(recoilOriginal) do
		pcall(function()
			for key, value in pairs(saved) do
				rawset(obj, key, value)
			end
		end)
	end
	table.clear(recoilOriginal)
end

task.spawn(function()
	while true do
		task.wait(1.5)
		if noRecoil.enabled then
			pcall(applyRecoil, noRecoil.scale)
		end
	end
end)

-- Chống giật camera: nếu game giật bằng cách xoay camera, bù lại phần xoay dọc đột ngột
local lastCamPitch = nil
RunService:BindToRenderStep("NoRecoilCam", Enum.RenderPriority.Camera.Value + 3, function()
	local cam = workspace.CurrentCamera
	if not cam or not noRecoil.enabled or state.running then
		lastCamPitch = nil
		return
	end
	local pitch = cam.CFrame:ToOrientation()
	if lastCamPitch and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
		local delta = pitch - lastCamPitch
		-- Giật lên đột ngột (không phải do chuột di chuyển) thì kéo xuống lại
		local mouseDelta = UserInputService:GetMouseDelta()
		if delta > 0.002 and math.abs(mouseDelta.Y) < 1 then
			local fix = delta * (1 - noRecoil.scale)
			cam.CFrame = cam.CFrame * CFrame.Angles(-fix, 0, 0)
			pitch = pitch - fix
		end
	end
	lastCamPitch = pitch
end)

