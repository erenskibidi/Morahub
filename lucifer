	teamCheck = false,
	showName = true,
	showHealth = true,
	showDistance = true,
	skeleton = false,
	skeletonColor = Color3.fromRGB(255, 255, 255),
	color = Color3.fromRGB(255, 60, 60),
}

local espObjects = {}
local skeletonObjects = {} -- [player] = { lines = { [index] = Drawing }, char = char }

local R15_BONES = {
	{ "Head", "UpperTorso" },
	{ "UpperTorso", "LowerTorso" },
	{ "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" }, { "LeftLowerArm", "LeftHand" },
	{ "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
	{ "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" }, { "LeftLowerLeg", "LeftFoot" },
	{ "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
}

local R6_BONES = {
	{ "Head", "Torso" },
	{ "Torso", "Left Arm" },
	{ "Torso", "Right Arm" },
	{ "Torso", "Left Leg" },
	{ "Torso", "Right Leg" },
}

local function espParent()
	if gethui then
		local ok, ui = pcall(gethui)
		if ok and ui then
			return ui
		end
	end
	return CoreGui
end

local function clearSkeleton(p)
	local s = skeletonObjects[p]
	if s then
		for _, line in pairs(s.lines) do
			pcall(function() line:Remove() end)
		end
		skeletonObjects[p] = nil
	end
end

local function clearEsp(p)
	local o = espObjects[p]
	if o then
		pcall(function() o.hl:Destroy() end)
		pcall(function() o.bb:Destroy() end)
		espObjects[p] = nil
	end
	clearSkeleton(p)
end

local function buildEsp(p, char)
	local old = espObjects[p]
	if old then
		pcall(function() old.hl:Destroy() end)
		pcall(function() old.bb:Destroy() end)
		espObjects[p] = nil
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	local hl = Instance.new("Highlight")
	hl.Adornee = char
	hl.FillTransparency = 0.65
	hl.FillColor = esp.color
	hl.OutlineColor = esp.color
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = espParent()

	local bb = Instance.new("BillboardGui")
	bb.Adornee = root
	bb.Size = UDim2.fromOffset(200, 40)
	bb.StudsOffset = Vector3.new(0, 3.5, 0)
	bb.AlwaysOnTop = true
	bb.Parent = espParent()

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 13
	label.TextColor3 = esp.color
	label.TextStrokeTransparency = 0.5
	label.Text = ""
	label.Parent = bb

	espObjects[p] = { char = char, hl = hl, bb = bb, label = label }
end

local function shouldShowEsp(p)
	if p == LocalPlayer then
		return false, nil, nil
	end
	local char = p.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (char and hum and hum.Health > 0) then
		return false, nil, nil
	end
	if esp.teamCheck and sameTeam(p) then
		return false, nil, nil
	end
	return true, char, hum
end

local function refreshEsp()
	local myRoot = getCharacterParts()
	for _, p in ipairs(Players:GetPlayers()) do
		local ok, char, hum = shouldShowEsp(p)
		if not (esp.enabled and ok) then
			local o = espObjects[p]
			if o then
				pcall(function() o.hl:Destroy() end)
				pcall(function() o.bb:Destroy() end)
				espObjects[p] = nil
			end
		else
			local o = espObjects[p]
			if not o or o.char ~= char or not o.hl.Parent then
				buildEsp(p, char)
				o = espObjects[p]
			end
			if o then
				o.hl.FillColor = esp.color
				o.hl.OutlineColor = esp.color
				o.label.TextColor3 = esp.color

				local parts = {}
				if esp.showName then
					table.insert(parts, p.DisplayName)
				end
				if esp.showHealth then
					table.insert(parts, ("HP %d"):format(math.floor(hum.Health)))
				end
				if esp.showDistance then
					local root = char:FindFirstChild("HumanoidRootPart")
					if root and myRoot then
						table.insert(parts, ("%dm"):format(math.floor((root.Position - myRoot.Position).Magnitude)))
					end
				end
				o.label.Text = table.concat(parts, " | ")
				o.label.Visible = not esp.box
			end
		end
	end
end

-- Skeleton ESP: vẽ bằng Drawing, cập nhật mỗi frame cho mượt
local function updateSkeleton()
	local cam = workspace.CurrentCamera
	if not cam or not Drawing then
		return
	end

	for _, p in ipairs(Players:GetPlayers()) do
		local ok, char = shouldShowEsp(p)
		if not (esp.skeleton and ok) then
			clearSkeleton(p)
		else
			local s = skeletonObjects[p]
			if not s or s.char ~= char then
				clearSkeleton(p)
				s = { char = char, lines = {} }
				skeletonObjects[p] = s
			end

			local bones = char:FindFirstChild("UpperTorso") and R15_BONES or R6_BONES
			for i, bone in ipairs(bones) do
				local a = char:FindFirstChild(bone[1])
				local b = char:FindFirstChild(bone[2])
				local line = s.lines[i]
				if not line then
					line = Drawing.new("Line")
					line.Thickness = 1.5
					line.Transparency = 1
					s.lines[i] = line
				end
				line.Color = esp.skeletonColor

				if a and b then
					local pa, onA = cam:WorldToViewportPoint(a.Position)
					local pb, onB = cam:WorldToViewportPoint(b.Position)
					if onA and onB and pa.Z > 0 and pb.Z > 0 then
						line.From = Vector2.new(pa.X, pa.Y)
						line.To = Vector2.new(pb.X, pb.Y)
						line.Visible = true
					else
						line.Visible = false
					end
				else
					line.Visible = false
				end
			end
		end
	end
end

