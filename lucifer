local function setAntiAFK(on)
	state.antiAFK = on
	if on then
		if not state.idleConn then
			state.idleConn = LocalPlayer.Idled:Connect(function()
				pcall(function()
					VirtualUser:CaptureController()
					VirtualUser:ClickButton2(Vector2.new())
				end)
			end)
		end
	else
		if state.idleConn then
			state.idleConn:Disconnect()
			state.idleConn = nil
		end
	end
end

local function findRayfieldGuis()
	local guis = {}
	for _, obj in ipairs(CoreGui:GetChildren()) do
		if obj:IsA("ScreenGui") and obj.Name == "Rayfield" then
			table.insert(guis, obj)
		end
	end
	if gethui then
		for _, obj in ipairs(gethui():GetChildren()) do
			if obj:IsA("ScreenGui") and obj.Name == "Rayfield" then
				table.insert(guis, obj)
			end
		end
	end
	return guis
end

local function setMenuVisible(value)
	state.menuVisible = value
	for _, gui in ipairs(findRayfieldGuis()) do
		gui.Enabled = value
	end
end

