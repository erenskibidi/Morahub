	currentTarget = aim.enabled and getClosestTarget(aim) or nil
	if fovCircle then
		fovCircle.Visible = aim.enabled and aim.showFov
		fovCircle.Radius = aim.fov
		fovCircle.Position = UserInputService:GetMouseLocation()
	end
end)

-- Hook Raycast / FindPartOnRay (súng dùng raycast) và Mouse.Hit / Mouse.Target (súng dùng chuột)
pcall(function()
	if not (hookmetamethod and getnamecallmethod and checkcaller) then
		warn("[AutoFarm] Executor không hỗ trợ hookmetamethod, Silent Aim sẽ không hoạt động")
		return
	end

	local oldNamecall
	oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		local method = getnamecallmethod()
		if currentTarget and self == workspace and not checkcaller() then
			if method == "Raycast" then
				local args = table.pack(...)
				if typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
					args[2] = (currentTarget.Position - args[1]).Unit * args[2].Magnitude
					return oldNamecall(self, table.unpack(args, 1, args.n))
				end
			elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
				local args = table.pack(...)
				local ray = args[1]
				if typeof(ray) == "Ray" then
					args[1] = Ray.new(ray.Origin, (currentTarget.Position - ray.Origin).Unit * ray.Direction.Magnitude)
					return oldNamecall(self, table.unpack(args, 1, args.n))
				end
			end
		end
		return oldNamecall(self, ...)
	end))

	local oldIndex
	oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
		if currentTarget and self == Mouse and not checkcaller() then
			if key == "Hit" then
				return currentTarget.CFrame
			elseif key == "Target" then
				return currentTarget
			end
		end
		return oldIndex(self, key)
	end))

	-- Không can thiệp khi Auto Farm đang điều khiển camera
	if not aimbot.enabled or state.running then
		return
	end
	if aimbot.holdRMB and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		return
	end

	local cam = workspace.CurrentCamera
	if not cam then
		return
	end

	local target = getClosestTarget(aimbot)
	if not target then
		return
	end

	local goal = CFrame.lookAt(cam.CFrame.Position, target.Position)
	local alpha = math.clamp(1 / math.max(aimbot.smooth, 1), 0.02, 1)
	cam.CFrame = cam.CFrame:Lerp(goal, alpha)
end)

-- ==================== ESP ====================
local esp = {
	enabled = false,
	teamCheck = false,
	showName = true,
	showHealth = true,
	showDistance = true,
	color = Color3.fromRGB(255, 60, 60),
}

local espObjects = {}

local function espParent()
	if gethui then
		local ok, ui = pcall(gethui)
		if ok and ui then
			return ui
		end
	end
	return CoreGui
end

local function clearEsp(p)
	local o = espObjects[p]
	if o then
		pcall(function() o.hl:Destroy() end)
		pcall(function() o.bb:Destroy() end)
		espObjects[p] = nil
	end
end

local function buildEsp(p, char)
	clearEsp(p)
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	local hl = Instance.new("Highlight")
	hl.Adornee = char
	hl.FillTransparency = 0.65
	hl.FillColor = esp.color
	hl.OutlineColor = esp.color
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = espParent()

	local bb = Instance.new("BillboardGui")
	bb.Adornee = root
	bb.Size = UDim2.fromOffset(200, 40)
	bb.StudsOffset = Vector3.new(0, 3.5, 0)
	bb.AlwaysOnTop = true
	bb.Parent = espParent()

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 13
	label.TextColor3 = esp.color
	label.TextStrokeTransparency = 0.5
	label.Text = ""
	label.Parent = bb

	espObjects[p] = { char = char, hl = hl, bb = bb, label = label }
end

local function refreshEsp()
	local myRoot = getCharacterParts()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local char = p.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local show = esp.enabled and char and hum and hum.Health > 0 and not (esp.teamCheck and sameTeam(p))

			if not show then
				clearEsp(p)
			else
				local o = espObjects[p]
				if not o or o.char ~= char or not o.hl.Parent then
					buildEsp(p, char)
					o = espObjects[p]
				end
				if o then
					o.hl.FillColor = esp.color
					o.hl.OutlineColor = esp.color
					o.label.TextColor3 = esp.color

					local parts = {}
					if esp.showName then
						table.insert(parts, p.DisplayName)
					end
					if esp.showHealth then
						table.insert(parts, ("HP %d"):format(math.floor(hum.Health)))
					end
					if esp.showDistance then
						local root = char:FindFirstChild("HumanoidRootPart")
						if root and myRoot then
							table.insert(parts, ("%dm"):format(math.floor((root.Position - myRoot.Position).Magnitude)))
						end
					end
					o.label.Text = table.concat(parts, " | ")
				end
			end
		else
			clearEsp(p)
		end
	end
end

Players.PlayerRemoving:Connect(clearEsp)

task.spawn(function()
	while true do
		task.wait(0.1)
		pcall(refreshEsp)
	end
end)

