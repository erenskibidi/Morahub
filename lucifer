	return hit.Instance:IsDescendantOf(part.Parent)
end

local function getClosestTarget(cfg)
	local cam = workspace.CurrentCamera
	if not cam then
		return nil
	end
	local mousePos = UserInputService:GetMouseLocation()
	local best, bestDist = nil, cfg.fov

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and not (cfg.teamCheck and sameTeam(p)) then
			local char = p.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local part = char and char:FindFirstChild(cfg.part)
			if part and hum and hum.Health > 0 then
				local sp, onScreen = cam:WorldToViewportPoint(part.Position)
				if onScreen then
					local d = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
					if d < bestDist and (not cfg.wallCheck or isVisible(part)) then
						best, bestDist = part, d
					end
				end
			end
		end
	end

	return best
end

