esp.box = false
esp.tracer = false
esp.boxHealth = true
esp.boxName = true
esp.boxDistance = true
esp.boxColor = Color3.fromRGB(0, 255, 80)

local boxObjects = {} -- [player] = { char, outline, box, name, dist, hpBack, hp, tracer }

local function newDrawing(kind, props)
	local d = Drawing.new(kind)
	for k, v in pairs(props) do
		d[k] = v
	end
	return d
end

local function clearBox(p)
	local o = boxObjects[p]
	if o then
		for key, d in pairs(o) do
			if key ~= "char" then
				pcall(function() d:Remove() end)
			end
		end
		boxObjects[p] = nil
	end
end

local function hideBox(o)
	for key, d in pairs(o) do
		if key ~= "char" then
			d.Visible = false
		end
	end
end

local function buildBox(p, char)
	return {
		char = char,
		outline = newDrawing("Square", { Thickness = 3, Filled = false, Color = Color3.new(0, 0, 0), Transparency = 1, Visible = false }),
		box = newDrawing("Square", { Thickness = 1.5, Filled = false, Color = esp.boxColor, Transparency = 1, Visible = false }),
		name = newDrawing("Text", { Size = 13, Center = true, Outline = true, Color = Color3.new(1, 1, 1), Visible = false }),
		dist = newDrawing("Text", { Size = 12, Center = true, Outline = true, Color = Color3.new(1, 1, 1), Visible = false }),
		hpBack = newDrawing("Square", { Filled = true, Color = Color3.new(0, 0, 0), Transparency = 1, Visible = false }),
		hp = newDrawing("Square", { Filled = true, Color = Color3.fromRGB(0, 255, 0), Transparency = 1, Visible = false }),
		tracer = newDrawing("Line", { Thickness = 1, Color = esp.boxColor, Transparency = 1, Visible = false }),
	}
end

local function updateBoxEsp()
	local cam = workspace.CurrentCamera
	if not cam or not Drawing then
		return
	end

	for _, p in ipairs(Players:GetPlayers()) do
		local ok, char, hum = shouldShowEsp(p)
		if not ((esp.box or esp.tracer) and ok) then
			clearBox(p)
		else
			local root = char:FindFirstChild("HumanoidRootPart")
			local o = boxObjects[p]
			if not o or o.char ~= char then
				clearBox(p)
				o = buildBox(p, char)
				boxObjects[p] = o
			end

			if not root then
				hideBox(o)
			else
				local top, onTop = cam:WorldToViewportPoint(root.Position + Vector3.new(0, 2.9, 0))
				local bot, onBot = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3.1, 0))
				if not (onTop and onBot) or top.Z <= 0 or bot.Z <= 0 then
					hideBox(o)
				else
					local height = math.abs(bot.Y - top.Y)
					local width = height * 0.6
					local cx = top.X
					local x = cx - width / 2
					local y = top.Y

					o.outline.Visible = esp.box
					o.box.Visible = esp.box
					if esp.box then
						o.outline.Position = Vector2.new(x, y)
						o.outline.Size = Vector2.new(width, height)
						o.box.Position = Vector2.new(x, y)
						o.box.Size = Vector2.new(width, height)
						o.box.Color = esp.boxColor
					end

					local showHp = esp.box and esp.boxHealth
					o.hpBack.Visible = showHp
					o.hp.Visible = showHp
					if showHp then
						local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
						o.hpBack.Position = Vector2.new(x - 6, y - 1)
						o.hpBack.Size = Vector2.new(4, height + 2)
						o.hp.Position = Vector2.new(x - 5, y + height * (1 - ratio))
						o.hp.Size = Vector2.new(2, height * ratio)
						o.hp.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), ratio)
					end

					local showName = esp.box and esp.boxName
					o.name.Visible = showName
					if showName then
						o.name.Text = p.DisplayName
						o.name.Position = Vector2.new(cx, y - 16)
					end

					local showDist = esp.box and esp.boxDistance
					o.dist.Visible = showDist
					if showDist then
						local myRoot = getCharacterParts()
						local d = myRoot and math.floor((root.Position - myRoot.Position).Magnitude) or 0
						o.dist.Text = d .. "m"
						o.dist.Position = Vector2.new(cx, y + height + 2)
					end

					o.tracer.Visible = esp.tracer
					if esp.tracer then
						o.tracer.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
						o.tracer.To = Vector2.new(cx, y + height)
						o.tracer.Color = esp.boxColor
					end
				end
			end
		end
	end
end

