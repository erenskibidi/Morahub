	CurrentValue = false,
	Flag = "NoRecoil",
	Callback = function(value)
		noRecoil.enabled = value
		if value then
			task.spawn(function()
				pcall(applyRecoil, noRecoil.scale)
			end)
		else
			restoreRecoil()
		end
	end,
})

RecoilTab:CreateSlider({
	Name = "Mức giật còn lại (0 = không giật)",
	Range = { 0, 100 },
	Increment = 5,
	Suffix = "%",
	CurrentValue = 0,
	Flag = "RecoilScale",
	Callback = function(value)
		noRecoil.scale = value / 100
		if noRecoil.enabled then
			task.spawn(function()
				pcall(applyRecoil, noRecoil.scale)
			end)
		end
	end,
})

