-- ===================== TÍNH NĂNG: AUTO FARM =====================
Hub.S.farm = {
	running = false,
	holdingE = false,
	focusPos = nil,
	camLocked = false,
	origMinZoom = nil,
	hold = 6,
	range = 200,
	cooldown = 1,
	blacklistTime = 45,
	speed = 45,
	arc = 8,
	camDist = 7,
	types = { trash = true, dumpster = true },
	antiToy = true,
	showRange = false,
	rangeColor = Color3.fromRGB(0, 255, 255),
	blacklist = setmetatable({}, { __mode = "k" }),
}

do
	local F = Hub.S.farm
	local CAM_BIND = "LuciferFarmCam"
	local VOID_Y, STAND_OFF, SHORT_DIST, ARRIVE_WAIT, MAX_STUCK = -200, 2.5, 12, 0.3, 10
	local rangePart

	local function cam()
		return workspace.CurrentCamera
	end

	local function resolvePart(prompt)
		local parent = prompt.Parent
		if not parent then
			return nil
		end
		if parent:IsA("BasePart") then
			return parent
		end
		if parent:IsA("Attachment") then
			local p = parent.Parent
			return (p and p:IsA("BasePart")) and p or nil
		end
		if parent:IsA("Model") then
			return parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart", true)
		end
		return parent:FindFirstAncestorWhichIsA("BasePart") or parent:FindFirstChildWhichIsA("BasePart", true)
	end

	local function activationRange(prompt)
		local d = prompt.MaxActivationDistance
		if not d or d <= 0 then
			d = 10
		end
		return math.max(d, 6)
	end

	local function isToyBox(prompt)
		if not F.antiToy then
			return false
		end
		local combined = ((prompt.ObjectText or "") .. " " .. (prompt.ActionText or "") .. " " .. (prompt.Parent and prompt.Parent.Name or "")):lower()
		return combined:find("toy box") or combined:find("toybox") or combined:find("view pack") or false
	end

	local function trim(s)
		return (s:lower():gsub("^%s+", ""):gsub("%s+$", ""))
	end

	local function isTrashPrompt(prompt)
		local obj = trim(prompt.ObjectText or "")
		local act = trim(prompt.ActionText or "")
		return act == "search" and F.types[obj] == true
	end

	local function promptValid(prompt, part)
		if not prompt or not prompt.Parent or not prompt.Enabled then
			return false
		end
		if not isTrashPrompt(prompt) or isToyBox(prompt) then
			return false
		end
		if not prompt:IsDescendantOf(workspace) or not part or not part:IsDescendantOf(workspace) then
			return false
		end
		return part.Position.Y >= VOID_Y
	end

	local function rayParams()
		local p = RaycastParams.new()
		p.FilterType = Enum.RaycastFilterType.Exclude
		p.FilterDescendantsInstances = { LocalPlayer.Character }
		return p
	end

	local function groundAt(x, z, originY)
		local hit = workspace:Raycast(Vector3.new(x, originY, z), Vector3.new(0, -80, 0), rayParams())
		return hit and hit.Position.Y or nil
	end

	local function blockedAt(pos, target)
		local op = OverlapParams.new()
		op.FilterType = Enum.RaycastFilterType.Exclude
		op.FilterDescendantsInstances = { LocalPlayer.Character }
		for _, p in ipairs(workspace:GetPartBoundsInBox(CFrame.new(pos + Vector3.new(0, 1.5, 0)), Vector3.new(1.8, 4, 1.8), op)) do
			if p ~= target and p.CanCollide and p.Transparency < 0.9 then
				return true
			end
		end
		return false
	end

	local function lineOfSight(from, prompt, part)
		if not prompt.RequiresLineOfSight then
			return true
		end
		local hit = workspace:Raycast(from, part.Position - from, rayParams())
		if not hit or hit.Instance == part then
			return true
		end
		local container = part.Parent
		return container ~= nil and container ~= workspace and hit.Instance:IsDescendantOf(container)
	end

	local function goodStand(pos, prompt, part)
		local maxD = activationRange(prompt) - 0.8
		local gy = groundAt(pos.X, pos.Z, part.Position.Y + 10)
		if not gy or gy < VOID_Y then
			return nil
		end
		local stand = Vector3.new(pos.X, gy + 3, pos.Z)
		if (stand - part.Position).Magnitude > maxD or blockedAt(stand, part) then
			return nil
		end
		if not lineOfSight(stand + Vector3.new(0, 1.5, 0), prompt, part) then
			return nil
		end
		return stand
	end

	local function findStandCF(prompt, part, root)
		local maxD = activationRange(prompt) - 0.8
		local toRoot = Vector3.new(root.Position.X - part.Position.X, 0, root.Position.Z - part.Position.Z)
		local base = toRoot.Magnitude > 0.1 and math.atan2(toRoot.X, toRoot.Z) or 0
		local radii = { math.min(STAND_OFF, maxD), math.max(1.2, maxD * 0.5), math.max(1.2, maxD * 0.8) }
		local offsets = { 0, 30, -30, 60, -60, 90, -90, 120, -120, 150, -150, 180 }
		for _, r in ipairs(radii) do
			for _, deg in ipairs(offsets) do
				local a = base + math.rad(deg)
				local stand = goodStand(Vector3.new(part.Position.X + math.sin(a) * r, part.Position.Y, part.Position.Z + math.cos(a) * r), prompt, part)
				if stand then
					return CFrame.lookAt(stand, Vector3.new(part.Position.X, stand.Y, part.Position.Z))
				end
			end
		end
		return nil
	end

	local function canInteract(root, prompt, part)
		if not root or not promptValid(prompt, part) then
			return false
		end
		if (root.Position - part.Position).Magnitude > activationRange(prompt) + 1 then
			return false
		end
		return lineOfSight(root.Position + Vector3.new(0, 1.5, 0), prompt, part)
	end

	local function computeCam(head, focus)
		local toFocus = focus - head.Position
		local flat = Vector3.new(toFocus.X, 0, toFocus.Z)
		if flat.Magnitude < 0.1 then
			flat = head.CFrame.LookVector * Vector3.new(1, 0, 1)
		end
		local back = -flat.Unit
		local params = rayParams()
		params.IgnoreWater = true
		local origin = head.Position + Vector3.new(0, 1.2, 0)
		local desired = origin + back * F.camDist
		local hit = workspace:Raycast(origin, desired - origin, params)
		local camPos = hit and (origin + back * math.max(hit.Distance - 0.6, 0.6)) or desired
		return CFrame.lookAt(camPos, focus)
	end

	local function lockCamera()
		if F.camLocked then
			return
		end
		F.camLocked = true
		if cam() then
			cam().CameraType = Enum.CameraType.Scriptable
		end
		RunService:BindToRenderStep(CAM_BIND, Enum.RenderPriority.Camera.Value + 1, function()
			if not F.running then
				return
			end
			local char, root = getChar()
			local head = char and char:FindFirstChild("Head")
			local c = cam()
			if not head or not root or not c then
				return
			end
			if c.CameraType ~= Enum.CameraType.Scriptable then
				c.CameraType = Enum.CameraType.Scriptable
			end
			c.CFrame = computeCam(head, F.focusPos or (root.Position + root.CFrame.LookVector * 10))
		end)
	end

	local function unlockCamera()
		if not F.camLocked then
			return
		end
		F.camLocked = false
		pcall(function()
			RunService:UnbindFromRenderStep(CAM_BIND)
		end)
		pcall(function()
			local _, hum = getRootHum()
			cam().CameraType = Enum.CameraType.Custom
			if hum then
				cam().CameraSubject = hum
			end
		end)
	end

	local function unstick()
		local root, hum = getRootHum()
		if not root or not hum then
			return
		end
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.CFrame = root.CFrame + Vector3.new(0, 4, 0)
		task.wait(0.3)
	end

	local function setHoldE(down)
		if F.holdingE == down then
			return
		end
		F.holdingE = down
		pcall(function()
			VirtualInputManager:SendKeyEvent(down, Enum.KeyCode.E, false, game)
		end)
	end

	local function travelTo(targetCF)
		local root, hum = getRootHum()
		if not root or not hum or hum.Health <= 0 then
			return false
		end
		local startPos, goal = root.Position, targetCF.Position
		local total = (goal - startPos).Magnitude
		if total < 0.5 then
			root.CFrame = targetCF
			return true
		end
		local speed = math.max(F.speed, 15)
		local arcH = total > SHORT_DIST and F.arc or 0
		local traveled, stuck, lastDesired = 0, 0, nil

		while F.running and traveled < total do
			local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
			root, hum = getRootHum()
			if not root or not hum or hum.Health <= 0 then
				return false
			end
			if lastDesired then
				if (root.Position - lastDesired).Magnitude > 2.5 then
					stuck += 1
					if stuck >= MAX_STUCK then
						return false
					end
				else
					stuck = 0
				end
			end
			traveled = math.min(total, traveled + speed * dt)
			local alpha = traveled / total
			local pos = startPos:Lerp(goal, alpha) + Vector3.new(0, math.sin(alpha * math.pi) * arcH, 0)
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.CFrame = CFrame.new(pos)
			lastDesired = pos
		end
		if not F.running then
			return false
		end
		for _ = 1, 4 do
			root = getRootHum()
			if not root then
				return false
			end
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.CFrame = targetCF
			RunService.Heartbeat:Wait()
		end
		root = getRootHum()
		return root ~= nil and (root.Position - targetCF.Position).Magnitude < 5
	end

	local promptCache = nil
	local function getPrompts()
		if not promptCache then
			promptCache = {}
			for _, d in ipairs(workspace:GetDescendants()) do
				if d:IsA("ProximityPrompt") then
					table.insert(promptCache, d)
				end
			end
			connect(workspace.DescendantAdded, function(d)
				if d:IsA("ProximityPrompt") then
					table.insert(promptCache, d)
				end
			end)
		end
		for i = #promptCache, 1, -1 do
			if not promptCache[i].Parent then
				table.remove(promptCache, i)
			end
		end
		return promptCache
	end

	local function findTarget(root)
		local best, bestPart, bestDist = nil, nil, math.huge
		local now = os.clock()
		for _, obj in ipairs(getPrompts()) do
			if obj.Parent then
				local part = resolvePart(obj)
				if promptValid(obj, part) then
					local last = F.blacklist[obj]
					if not last or now - last > F.blacklistTime then
						local d = (part.Position - root.Position).Magnitude
						if d <= F.range and d < bestDist then
							best, bestPart, bestDist = obj, part, d
						end
					end
				end
			end
		end
		return best, bestPart
	end

	local function holdEFor(duration, prompt, part)
		setHoldE(true)
		local start = os.clock()
		while F.running and os.clock() - start < duration do
			if not (prompt.Parent and prompt.Enabled) then
				break
			end
			F.focusPos = part.Position
			task.wait(0.1)
		end
		setHoldE(false)
	end

	local function farmLoop()
		while F.running do
			local root, hum = getRootHum()
			if not root or not hum or hum.Health <= 0 then
				task.wait(1)
				continue
			end
			local prompt, part = findTarget(root)
			if not prompt then
				F.focusPos = nil
				task.wait(1)
				continue
			end
			F.blacklist[prompt] = os.clock()
			F.focusPos = part.Position

			local arrived = false
			for _ = 1, 2 do
				if not F.running then
					break
				end
				local r = getRootHum()
				if not r then
					break
				end
				local standCF = findStandCF(prompt, part, r)
				if not standCF then
					break
				end
				if travelTo(standCF) then
					arrived = true
					break
				end
				unstick()
			end

			if not arrived or not F.running then
				F.focusPos = nil
				task.wait(F.cooldown)
				continue
			end
			task.wait(ARRIVE_WAIT)
			if not F.running then
				break
			end
			F.focusPos = part.Position

			root = getRootHum()
			if root and not canInteract(root, prompt, part) then
				unstick()
				local standCF = findStandCF(prompt, part, root)
				if standCF then
					travelTo(standCF)
					task.wait(ARRIVE_WAIT)
				end
				root = getRootHum()
			end
			if not root or not F.running or not canInteract(root, prompt, part) then
				task.wait(F.cooldown)
				continue
			end

			holdEFor(F.hold, prompt, part)
			if F.running and prompt.Parent and prompt.Enabled and fireproximityprompt then
				pcall(fireproximityprompt, prompt)
			end
			setHoldE(false)
			F.focusPos = nil
			task.wait(F.cooldown)
		end
		setHoldE(false)
		F.focusPos = nil
	end

	local function restoreZoom()
		if F.origMinZoom then
			pcall(function()
				LocalPlayer.CameraMinZoomDistance = F.origMinZoom
			end)
			F.origMinZoom = nil
		end
	end

	local function stopCleanup()
		F.running = false
		setHoldE(false)
		F.focusPos = nil
		unlockCamera()
		restoreZoom()
	end

	function Hub.SetFarm(value)
		if F.running == value then
			return
		end
		F.running = value
		if value then
			pcall(function()
				F.origMinZoom = LocalPlayer.CameraMinZoomDistance
				LocalPlayer.CameraMinZoomDistance = 0.5
			end)
			lockCamera()
			task.spawn(function()
				local ok, err = pcall(farmLoop)
				if not ok then
					warn("[AutoFarm] " .. tostring(err))
				end
				stopCleanup()
			end)
		else
			stopCleanup()
		end
	end

	connect(RunService.RenderStepped, function()
		if not F.showRange then
			if rangePart then
				rangePart:Destroy()
				rangePart = nil
			end
			return
		end
		local root = getRootHum()
		if not root then
			return
		end
		if not rangePart or not rangePart.Parent then
			rangePart = make("Part", {
				Name = "RangeVisualizer", Shape = Enum.PartType.Cylinder, Anchored = true, CanCollide = false,
				CastShadow = false, Material = Enum.Material.Neon, Transparency = 0.5,
			}, workspace)
		end
		rangePart.Color = F.rangeColor
		rangePart.Size = Vector3.new(0.4, F.range * 2, F.range * 2)
		rangePart.CFrame = CFrame.new(root.Position - Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, 0, math.rad(90))
	end)

	Hub.OnUnload(function()
		stopCleanup()
		if rangePart then
			rangePart:Destroy()
		end
	end)
end

-- ===================== TÍNH NĂNG: COMBAT =====================
Hub.S.aim = {
	enabled = false, fov = 150, part = "Head", team = false, wall = false, showFov = false,
	hitChance = 100, target = nil, rolled = true, hooks = false,
}
Hub.S.trigger = { enabled = false, delay = 0.08, last = 0 }
Hub.S.recoil = { enabled = false, scale = 0 }
Hub.S.spread = { enabled = false }
Hub.S.spin = { enabled = false, speed = 8, active = false }
Hub.S.hitbox = { enabled = false, size = 6, transparency = 0.7 }

do
	local A = Hub.S.aim
	local Mouse = LocalPlayer:GetMouse()

	local fovCircle
	pcall(function()
		if Drawing then
			fovCircle = Drawing.new("Circle")
			fovCircle.Thickness = 1
			fovCircle.NumSides = 64
			fovCircle.Filled = false
			fovCircle.Color = Color3.new(1, 1, 1)
			fovCircle.Visible = false
			Hub.Maid:Give(fovCircle)
		end
	end)

	local function visible(part)
		local c = workspace.CurrentCamera
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { LocalPlayer.Character }
		local hit = workspace:Raycast(c.CFrame.Position, part.Position - c.CFrame.Position, params)
		return not hit or hit.Instance:IsDescendantOf(part.Parent)
	end

	local function closestTarget()
		local c = workspace.CurrentCamera
		if not c then
			return nil
		end
		local mousePos = UserInputService:GetMouseLocation()
		local best, bestDist = nil, A.fov
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and not (A.team and sameTeam(p)) then
				local char = p.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local partName = A.part
				if partName == "Random" then
					partName = ({ "Head", "HumanoidRootPart" })[math.random(1, 2)]
				end
				local part = char and char:FindFirstChild(partName)
				if part and hum and hum.Health > 0 then
					local sp, onScreen = c:WorldToViewportPoint(part.Position)
					if onScreen then
						local d = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
						if d < bestDist and (not A.wall or visible(part)) then
							best, bestDist = part, d
						end
					end
				end
			end
		end
		return best
	end

	local lastRoll = 0
	connect(RunService.RenderStepped, function()
		if os.clock() - lastRoll > 0.25 then
			lastRoll = os.clock()
			A.rolled = math.random(1, 100) <= A.hitChance
		end
		A.target = (A.enabled and A.rolled) and closestTarget() or nil
		if fovCircle then
			fovCircle.Visible = A.enabled and A.showFov
			fovCircle.Radius = A.fov
			fovCircle.Position = UserInputService:GetMouseLocation()
		end
	end)

	function Hub.InstallAimHooks()
		if A.hooks then
			return
		end
		A.hooks = true
		pcall(function()
			if not (hookmetamethod and getnamecallmethod and checkcaller) then
				Hub.Notify({ Title = "Silent Aim", Content = "Executor không hỗ trợ hookmetamethod.", Color = THEME.danger })
				return
			end
			local oldNamecall
			oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
				local method = getnamecallmethod()
				local target = A.target
				if target and self == workspace and not checkcaller() then
					if method == "Raycast" then
						local args = table.pack(...)
						if typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
							args[2] = (target.Position - args[1]).Unit * args[2].Magnitude
							return oldNamecall(self, table.unpack(args, 1, args.n))
						end
					elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
						local args = table.pack(...)
						local ray = args[1]
						if typeof(ray) == "Ray" then
							args[1] = Ray.new(ray.Origin, (target.Position - ray.Origin).Unit * ray.Direction.Magnitude)
							return oldNamecall(self, table.unpack(args, 1, args.n))
						end
					end
				end
				return oldNamecall(self, ...)
			end))

			local oldIndex
			oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
				local target = A.target
				if target and self == Mouse and not checkcaller() then
					if key == "Hit" then
						return target.CFrame
					elseif key == "Target" then
						return target
					end
				end
				return oldIndex(self, key)
			end))
		end)
	end

	-- Triggerbot
	local T = Hub.S.trigger
	connect(RunService.Heartbeat, function()
		if not T.enabled or os.clock() - T.last < T.delay then
			return
		end
		local c = workspace.CurrentCamera
		if not c then
			return
		end
		local loc = UserInputService:GetMouseLocation()
		local ray = c:ViewportPointToRay(loc.X, loc.Y)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { LocalPlayer.Character }
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
		if not hit then
			return
		end
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and hit.Instance:IsDescendantOf(p.Character) and not (A.team and sameTeam(p)) then
				local hum = p.Character:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then
					T.last = os.clock()
					pcall(function()
						VirtualInputManager:SendMouseButtonEvent(loc.X, loc.Y, 0, true, game, 0)
						task.wait(0.02)
						VirtualInputManager:SendMouseButtonEvent(loc.X, loc.Y, 0, false, game, 0)
					end)
				end
				return
			end
		end
	end)

	Hub.OnUnload(function()
		A.enabled = false
		A.target = nil
		T.enabled = false
	end)
end

-- No Recoil / No Spread
do
	local R, SP = Hub.S.recoil, Hub.S.spread
	local stores = { recoil = setmetatable({}, { __mode = "k" }), spread = setmetatable({}, { __mode = "k" }) }

	local function scanRaw(pattern, store, scale)
		if not getgc then
			return
		end
		local ok, objects = pcall(function() return getgc(true) end)
		if not ok then
			return
		end
		for i, obj in ipairs(objects) do
			if i % 1500 == 0 then
				task.wait() -- nhả khung hình, không làm đứng game
			end
			if type(obj) == "table" and not (isreadonly and isreadonly(obj)) then
				pcall(function()
					for key, value in pairs(obj) do
						if type(key) == "string" and type(value) == "number" and key:lower():find(pattern) then
							local saved = store[obj]
							if not saved then
								saved = {}
								store[obj] = saved
							end
							if saved[key] == nil then
								saved[key] = value
							end
							rawset(obj, key, saved[key] * scale)
						end
					end
				end)
			end
		end
	end

	local scanning = false
	local function scan(pattern, store, scale)
		if scanning then
			return
		end
		scanning = true
		pcall(scanRaw, pattern, store, scale)
		scanning = false
	end

	local function restore(store)
		for obj, saved in pairs(store) do
			pcall(function()
				for key, value in pairs(saved) do
					rawset(obj, key, value)
				end
			end)
		end
		table.clear(store)
	end

	function Hub.ApplyRecoil()
		if R.enabled then
			scan("recoil", stores.recoil, R.scale)
		else
			restore(stores.recoil)
		end
	end
	function Hub.ApplySpread()
		if SP.enabled then
			scan("spread", stores.spread, 0)
		else
			restore(stores.spread)
		end
	end

	task.spawn(function()
		while not Hub.Unloaded do
			task.wait(6)
			if R.enabled then
				pcall(scan, "recoil", stores.recoil, R.scale)
			end
			if SP.enabled then
				pcall(scan, "spread", stores.spread, 0)
			end
		end
	end)

	local lastPitch
	RunService:BindToRenderStep("LuciferNoRecoilCam", Enum.RenderPriority.Camera.Value + 3, function()
		local c = workspace.CurrentCamera
		if not c or not R.enabled or Hub.S.farm.running then
			lastPitch = nil
			return
		end
		local pitch = c.CFrame:ToOrientation()
		if lastPitch and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
			local delta = pitch - lastPitch
			if delta > 0.002 and math.abs(UserInputService:GetMouseDelta().Y) < 1 then
				local fix = delta * (1 - R.scale)
				c.CFrame = c.CFrame * CFrame.Angles(-fix, 0, 0)
				pitch -= fix
			end
		end
		lastPitch = pitch
	end)

	Hub.OnUnload(function()
		pcall(function()
			RunService:UnbindFromRenderStep("LuciferNoRecoilCam")
		end)
		R.enabled, SP.enabled = false, false
		restore(stores.recoil)
		restore(stores.spread)
	end)
end

