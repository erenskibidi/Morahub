local UILib = {}

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	if parent then
		o.Parent = parent
	end
	return o
end

local function corner(o, r)
	return make("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o)
end

local function tween(o, t, props, style)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

local function label(parent, text, size, color, font, xalign)
	return make("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size,
		TextColor3 = color,
		Font = font or Enum.Font.GothamMedium,
		TextXAlignment = xalign or Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, parent)
end

local function makeDraggable(handle, target)
	local dragging, startInput, startPos = false, nil, nil
	Hub.Maid:Give(handle.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			startInput = input.Position
			startPos = target.Position
		end
	end))
	Hub.Maid:Give(UserInputService.InputChanged:Connect(function(input)
		if dragging and isMove(input) then
			local d = input.Position - startInput
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end))
	Hub.Maid:Give(UserInputService.InputEnded:Connect(function(input)
		if isPress(input) then
			dragging = false
		end
	end))
end

local function bindDrag(hit, onAlpha)
	local active = false
	local function update(x)
		onAlpha(clamp01((x - hit.AbsolutePosition.X) / math.max(hit.AbsoluteSize.X, 1)))
	end
	Hub.Maid:Give(hit.InputBegan:Connect(function(input)
		if isPress(input) then
			active = true
			update(input.Position.X)
		end
	end))
	Hub.Maid:Give(UserInputService.InputChanged:Connect(function(input)
		if active and isMove(input) then
			update(input.Position.X)
		end
	end))
	Hub.Maid:Give(UserInputService.InputEnded:Connect(function(input)
		if isPress(input) then
			active = false
		end
	end))
end

local function screenPos(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		return Vector2.new(input.Position.X, input.Position.Y + GuiService:GetGuiInset().Y)
	end
	return UserInputService:GetMouseLocation()
end

local function bindDragXY(hit, onAlpha)
	local active = false
	local function update(input)
		local pos = screenPos(input)
		onAlpha(
			clamp01((pos.X - hit.AbsolutePosition.X) / math.max(hit.AbsoluteSize.X, 1)),
			clamp01((pos.Y - hit.AbsolutePosition.Y) / math.max(hit.AbsoluteSize.Y, 1))
		)
	end
	Hub.Maid:Give(hit.InputBegan:Connect(function(input)
		if isPress(input) then
			active = true
			update(input)
		end
	end))
	Hub.Maid:Give(UserInputService.InputChanged:Connect(function(input)
		if active and isMove(input) then
			update(input)
		end
	end))
	Hub.Maid:Give(UserInputService.InputEnded:Connect(function(input)
		if isPress(input) then
			active = false
		end
	end))
end

local function registerFlag(flag, value, setter)
	if not flag then
		return
	end
	Hub.Flags[flag] = value
	Hub.Setters[flag] = setter
end

