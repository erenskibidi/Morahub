		if opt.Flag then Hub.Flags[opt.Flag] = value end
		render(true)
		if not silent then
			safe(opt.Callback, value)
		end
	end
	function obj:Set(v)
		set(v)
	end
	function obj:Get()
		return value
	end

	connect(sw.MouseButton1Click, function()
		set(not value)
	end)

	registerFlag(opt.Flag, value, function(v)
		set(v)
	end)
	task.spawn(safe, opt.Callback, value)
	return obj
end

function TabMethods:AddSlider(opt)
	local min, max = opt.Min, opt.Max
	local inc = opt.Increment or 1
	local value = math.clamp(opt.Default or min, min, max)
	local c = newCard(self, 52)

	local name = label(c, opt.Name, 13, THEME.text)
	name.Position = UDim2.new(0, 12, 0, 6)
	name.Size = UDim2.new(1, -120, 0, 18)

	local valLabel = label(c, "", 12, THEME.sub, Enum.Font.GothamMedium, Enum.TextXAlignment.Right)
	valLabel.Position = UDim2.new(1, -112, 0, 6)
	valLabel.Size = UDim2.new(0, 100, 0, 18)

	local hit = make("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 28),
		Size = UDim2.new(1, -24, 0, 20),
	}, c)
	local bar = make("Frame", {
		BackgroundColor3 = THEME.card2,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0.5, -3),
		Size = UDim2.new(1, 0, 0, 6),
	}, hit)
	corner(bar, 3)
	local fill = make("Frame", { BackgroundColor3 = THEME.accent, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0) }, bar)
	corner(fill, 3)
	onAccent(function(col)
		fill.BackgroundColor3 = col
	end)

	local function render()
		local a = (max > min) and (value - min) / (max - min) or 0
		fill.Size = UDim2.new(a, 0, 1, 0)
		valLabel.Text = tostring(value) .. (opt.Suffix and (" " .. opt.Suffix) or "")
	end
	render()

	local function setValue(v, silent)
		v = math.clamp(v, min, max)
		v = min + math.floor((v - min) / inc + 0.5) * inc
		v = math.clamp(tonumber(string.format("%.3f", v)) or v, min, max)
		if v ~= value then
			value = v
			if opt.Flag then Hub.Flags[opt.Flag] = value end
			render()
			if not silent then
				safe(opt.Callback, value)
			end
		end
	end

	bindDrag(hit, function(a)
		setValue(min + a * (max - min))
	end)

	local obj = {}
	function obj:Set(v)
		setValue(v)
	end
	function obj:Get()
		return value
	end
	registerFlag(opt.Flag, value, function(v)
		setValue(tonumber(v) or value)
	end)
	task.spawn(safe, opt.Callback, value)
	return obj
end

