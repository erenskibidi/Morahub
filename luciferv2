do
	local P = Hub.S.players

	function Hub.PlayerNames()
		local names = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then
				table.insert(names, p.Name)
			end
		end
		table.sort(names, function(a, b)
			return a:lower() < b:lower()
		end)
		if #names == 0 then
			names = { "(không có ai)" }
		end
		return names
	end

	local function target()
		return P.selected and Players:FindFirstChild(P.selected)
	end

	function Hub.TeleportToSelected()
		local p = target()
		local root = getRootHum()
		local tr = p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if root and tr then
			root.CFrame = tr.CFrame * CFrame.new(0, 0, 3)
			Hub.Notify({ Title = "Teleport", Content = "Đã tới " .. p.Name, Duration = 2 })
		else
			Hub.Notify({ Title = "Teleport", Content = "Không tìm thấy người chơi.", Color = THEME.danger, Duration = 2 })
		end
