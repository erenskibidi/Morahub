-- ===================== TÍNH NĂNG: MOVEMENT =====================
Hub.S.speed = { enabled = false, value = 50 }
Hub.S.fly = { enabled = false, speed = 60, active = false }
Hub.S.noclip = { enabled = false }
Hub.S.infjump = { enabled = false }
Hub.S.clicktp = { enabled = false }
Hub.S.antivoid = { enabled = false, safe = nil }

do
	local SPD, FLY, NC, IJ, CT, AV = Hub.S.speed, Hub.S.fly, Hub.S.noclip, Hub.S.infjump, Hub.S.clicktp, Hub.S.antivoid

	connect(RunService.Heartbeat, function(dt)
		if not SPD.enabled or Hub.S.farm.running or FLY.enabled then
			return
		end
		local root, hum = getRootHum()
		if not root or not hum or hum.Health <= 0 or hum.SeatPart ~= nil then
			return
		end
		if not UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:GetFocusedTextBox() then
			return
		end
		local dir = hum.MoveDirection
		if dir.Magnitude < 0.1 then
			return
		end
		root.CFrame = root.CFrame + dir.Unit * math.max(SPD.value - hum.WalkSpeed, 0) * dt
	end)

	local function stopFly()
		if FLY.active then
			FLY.active = false
			local root, hum = getRootHum()
			if hum then
				hum.PlatformStand = false
			end
			if root then
				root.AssemblyLinearVelocity = Vector3.zero
			end
		end
	end

	connect(RunService.Heartbeat, function()
		local root, hum = getRootHum()
		if not root or not hum or hum.Health <= 0 then
			FLY.active = false
			return
		end
		if not FLY.enabled or Hub.S.farm.running or hum.SeatPart ~= nil then
			stopFly()
			return
		end
		FLY.active = true
		hum.PlatformStand = true
		local c = workspace.CurrentCamera
		local cf = c.CFrame
		local dir = Vector3.zero
		local focused = UserInputService:GetFocusedTextBox()
		if not focused then
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
		end
		root.AssemblyLinearVelocity = dir.Magnitude > 0 and dir.Unit * FLY.speed or Vector3.zero
	end)

	connect(RunService.Stepped, function()
		if not NC.enabled then
			return
		end
		local char = LocalPlayer.Character
		if char then
			for _, p in ipairs(char:GetDescendants()) do
				if p:IsA("BasePart") and p.CanCollide then
					p.CanCollide = false
				end
			end
		end
	end)

	connect(UserInputService.JumpRequest, function()
		if IJ.enabled then
			local _, hum = getRootHum()
			if hum then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end
	end)

	connect(UserInputService.InputBegan, function(input, processed)
		if processed or not CT.enabled then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			local c = workspace.CurrentCamera
			local loc = UserInputService:GetMouseLocation()
			local ray = c:ViewportPointToRay(loc.X, loc.Y)
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { LocalPlayer.Character }
			local hit = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
			local root = getRootHum()
			if hit and root then
				root.CFrame = CFrame.new(hit.Position + Vector3.new(0, 3.5, 0))
			end
		end
	end)

	task.spawn(function()
		while not Hub.Unloaded do
			task.wait(0.2)
			if AV.enabled then
				local root, hum = getRootHum()
				if root and hum then
					if hum.FloorMaterial ~= Enum.Material.Air and root.Position.Y > -100 then
						AV.safe = root.CFrame
					elseif root.Position.Y < -150 and AV.safe then
						root.AssemblyLinearVelocity = Vector3.zero
						root.CFrame = AV.safe + Vector3.new(0, 3, 0)
						Hub.Notify({ Title = "Anti Void", Content = "Đã đưa bạn về chỗ an toàn.", Duration = 2 })
					end
				end
			end
		end
	end)

	Hub.OnUnload(function()
		SPD.enabled, FLY.enabled, NC.enabled, IJ.enabled, CT.enabled, AV.enabled = false, false, false, false, false, false
		stopFly()
	end)
end

-- ===================== TÍNH NĂNG: ESP =====================
Hub.S.esp = {
	enabled = false, team = false, name = false, health = false, armor = false, distance = false,
	tracer = false, chams = false, box = false, newbieSize = 19, textSize = 14, boxScale = 100,
	thickness = 1.5, maxDist = 2000, color = Color3.fromRGB(255, 60, 60),
}

do
	local E = Hub.S.esp
	local NEWBIE_COLOR = Color3.fromRGB(70, 255, 110)
	local labels, chams, boxes = {}, {}, {}
	local rookieCache = setmetatable({}, { __mode = "k" })
	local armorCache = setmetatable({}, { __mode = "k" })
	local hasDrawing = false
	pcall(function()
		hasDrawing = Drawing ~= nil
	end)

	local function hasRookie(v)
		return type(v) == "string" and v:lower():find("rookie", 1, true) ~= nil
	end

	local function computeRookie(p, char)
		if hasRookie(p.DisplayName) or hasRookie(p.Name) or (p.Team and hasRookie(p.Team.Name)) then
			return true
		end
		for _, v in pairs(p:GetAttributes()) do
			if hasRookie(v) then
				return true
			end
		end
		local ls = p:FindFirstChild("leaderstats")
		if ls then
			for _, child in ipairs(ls:GetChildren()) do
				if hasRookie(child.Name) then
					return true
				end
				if child:IsA("ValueBase") then
					local ok, v = pcall(function()
						return child.Value
					end)
					if ok and hasRookie(v) then
						return true
					end
				end
			end
		end
		if char then
			for _, v in pairs(char:GetAttributes()) do
				if hasRookie(v) then
					return true
				end
			end
			for _, d in ipairs(char:GetDescendants()) do
				if (d:IsA("TextLabel") or d:IsA("TextButton")) and hasRookie(d.Text) then
					return true
				end
			end
		end
		return false
	end

	local function isRookie(p, char)
		local c = rookieCache[p]
		local now = os.clock()
		if not c or c.char ~= char or now - c.t > 10 then
			c = { t = now, char = char, v = computeRookie(p, char) }
			rookieCache[p] = c
		end
		return c.v
	end

	local function displayName(p, char)
		return isRookie(p, char) and "newbie" or p.DisplayName
	end

	local ARMOR_KEYS = { "armor", "armour", "vest", "kevlar", "shield" }
	local function armorName(n)
		n = tostring(n):lower()
		for _, k in ipairs(ARMOR_KEYS) do
			if n:find(k, 1, true) then
				return true
			end
		end
		return false
	end

	local function computeArmor(p, char, hum)
		for _, h in ipairs({ p, char, hum }) do
			if h then
				for k, v in pairs(h:GetAttributes()) do
					if type(v) == "number" and armorName(k) then
						return v
					end
				end
			end
		end
		for _, r in ipairs({ char, p }) do
			if r then
				for _, d in ipairs(r:GetDescendants()) do
					if (d:IsA("NumberValue") or d:IsA("IntValue")) and armorName(d.Name) then
						return d.Value
					end
				end
			end
		end
		return nil
	end

	local function findArmor(p, char, hum)
		local c = armorCache[p]
		local now = os.clock()
		if not c or c.char ~= char or now - c.t > 1 then
			c = { t = now, char = char, v = computeArmor(p, char, hum) }
			armorCache[p] = c
		end
		return c.v
	end

	local function shouldShow(p)
		if p == LocalPlayer then
			return false
		end
		local char = p.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not (char and hum and hum.Health > 0) then
			return false
		end
		if E.team and sameTeam(p) then
			return false
		end
		local root, myRoot = char:FindFirstChild("HumanoidRootPart"), getRootHum()
		if root and myRoot and (root.Position - myRoot.Position).Magnitude > E.maxDist then
			return false
		end
		return true, char, hum
	end

	local function clearLabel(p)
		local o = labels[p]
		if o then
			pcall(function() o.bb:Destroy() end)
			labels[p] = nil
		end
	end

	local function buildLabel(p, char)
		clearLabel(p)
		local root = char:FindFirstChild("HumanoidRootPart")
		if not root then
			return
		end
		local bb = make("BillboardGui", {
			Adornee = root, Size = UDim2.fromOffset(260, 64), StudsOffset = Vector3.new(0, 3.8, 0), AlwaysOnTop = true,
		}, guiParent())
		local lb = make("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Font = Enum.Font.GothamBold, TextSize = 13,
			TextColor3 = E.color, TextStrokeTransparency = 0.5, Text = "", RichText = true,
			TextYAlignment = Enum.TextYAlignment.Bottom,
		}, bb)
		labels[p] = { char = char, bb = bb, label = lb }
	end

	local function labelText(p, char, hum)
		local rookie = isRookie(p, char)
		local size = rookie and E.newbieSize or E.textSize
		local text = string.format('<font size="%d" color="%s"><b>%s</b></font>', size, rgbStr(rookie and NEWBIE_COLOR or E.color), xmlEscape(displayName(p, char)))
		local parts = {}
		if E.health then
			local ratio = clamp01(hum.Health / math.max(hum.MaxHealth, 1))
			local hc = Color3.fromRGB(255, 70, 70):Lerp(Color3.fromRGB(80, 255, 110), ratio)
			table.insert(parts, string.format('<font color="%s">HP %d</font>', rgbStr(hc), math.floor(hum.Health)))
		end
		if E.armor then
			local a = findArmor(p, char, hum)
			if a then
				table.insert(parts, string.format('<font color="rgb(90,170,255)">AR %d</font>', math.floor(a)))
			end
		end
		if #parts > 0 then
			text ..= string.format('\n<font size="%d">%s</font>', math.max(8, E.textSize - 4), table.concat(parts, "  "))
		end
		return text
	end

	local function clearChams(p)
		local h = chams[p]
		if h then
			pcall(function() h:Destroy() end)
			chams[p] = nil
		end
	end

	local function newDrawing(kind, props)
		local d = Drawing.new(kind)
		for k, v in pairs(props) do
			d[k] = v
		end
		return d
	end

	local function clearBox(p)
		local o = boxes[p]
		if o then
			for k, d in pairs(o) do
				if k ~= "char" then
					pcall(function() d:Remove() end)
				end
			end
			boxes[p] = nil
		end
	end

	local function hideBox(o)
		for k, d in pairs(o) do
			if k ~= "char" then
				d.Visible = false
			end
		end
	end

	local function buildBox(char)
		return {
			char = char,
			outline = newDrawing("Square", { Thickness = 3, Filled = false, Color = Color3.new(0, 0, 0), Transparency = 1, Visible = false }),
			box = newDrawing("Square", { Thickness = 1.5, Filled = false, Color = E.color, Transparency = 1, Visible = false }),
			name = newDrawing("Text", { Size = 13, Center = true, Outline = true, Color = Color3.new(1, 1, 1), Visible = false }),
			dist = newDrawing("Text", { Size = 12, Center = true, Outline = true, Color = Color3.new(1, 1, 1), Visible = false }),
			hpBack = newDrawing("Square", { Filled = true, Color = Color3.new(0, 0, 0), Transparency = 1, Visible = false }),
			hp = newDrawing("Square", { Filled = true, Color = Color3.fromRGB(0, 255, 0), Transparency = 1, Visible = false }),
			tracer = newDrawing("Line", { Thickness = 1, Color = E.color, Transparency = 1, Visible = false }),
		}
	end

	local function updateBoxes()
		local cam = workspace.CurrentCamera
		if not cam or not hasDrawing then
			return
		end
		if not E.enabled or not (E.box or E.tracer) then
			if next(boxes) then
				for p in pairs(boxes) do
					clearBox(p)
				end
			end
			return
		end
		if GuiService.MenuIsOpen then
			for _, o in pairs(boxes) do
				hideBox(o)
			end
			return
		end
		for _, p in ipairs(Players:GetPlayers()) do
			local ok, char, hum = shouldShow(p)
			if not (E.enabled and (E.box or E.tracer) and ok) then
				clearBox(p)
			else
				local root = char:FindFirstChild("HumanoidRootPart")
				local o = boxes[p]
				if not o or o.char ~= char then
					clearBox(p)
					o = buildBox(char)
					boxes[p] = o
				end
				if not root then
					hideBox(o)
				else
					local top, onTop = cam:WorldToViewportPoint(root.Position + Vector3.new(0, 2.9, 0))
					local bot, onBot = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3.1, 0))
					if not (onTop and onBot) or top.Z <= 0 or bot.Z <= 0 then
						hideBox(o)
					else
						local scale = E.boxScale / 100
						local height = math.abs(bot.Y - top.Y) * scale
						local width = height * 0.6
						local cx = top.X
						local x = cx - width / 2
						local y = (top.Y + bot.Y) / 2 - height / 2

						o.outline.Visible, o.box.Visible = E.box, E.box
						if E.box then
							o.outline.Thickness = E.thickness + 1.5
							o.outline.Position, o.outline.Size = Vector2.new(x, y), Vector2.new(width, height)
							o.box.Thickness = E.thickness
							o.box.Position, o.box.Size = Vector2.new(x, y), Vector2.new(width, height)
							o.box.Color = E.color
						end

						local showHp = E.box and E.health
						o.hpBack.Visible, o.hp.Visible = showHp, showHp
						if showHp then
							local ratio = clamp01(hum.Health / math.max(hum.MaxHealth, 1))
							local bw = math.max(2, math.floor(E.thickness + 0.5) + 1)
							o.hpBack.Position, o.hpBack.Size = Vector2.new(x - bw - 4, y - 1), Vector2.new(bw + 2, height + 2)
							o.hp.Position, o.hp.Size = Vector2.new(x - bw - 3, y + height * (1 - ratio)), Vector2.new(bw, height * ratio)
							o.hp.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), ratio)
						end

						local showName = E.box and E.name
						o.name.Visible = showName
						if showName then
							local rookie = isRookie(p, char)
							local size = rookie and math.max(12, E.newbieSize - 2) or E.textSize
							o.name.Text = displayName(p, char)
							o.name.Color = rookie and NEWBIE_COLOR or Color3.new(1, 1, 1)
							o.name.Size = size
							o.name.Position = Vector2.new(cx, y - size - 4)
						end

						local showDist = E.box and E.distance
						o.dist.Visible = showDist
						if showDist then
							local myRoot = getRootHum()
							o.dist.Text = (myRoot and math.floor((root.Position - myRoot.Position).Magnitude) or 0) .. "m"
							o.dist.Size = math.max(8, E.textSize - 1)
							o.dist.Position = Vector2.new(cx, y + height + 2)
						end

						o.tracer.Visible = E.tracer
						if E.tracer then
							o.tracer.Thickness = E.thickness
							o.tracer.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
							o.tracer.To = Vector2.new(cx, y + height)
							o.tracer.Color = E.color
						end
					end
				end
			end
		end
	end

	task.spawn(function()
		while not Hub.Unloaded do
			task.wait(0.1)
			pcall(function()
				for _, p in ipairs(Players:GetPlayers()) do
					local ok, char, hum = shouldShow(p)
					if not (E.enabled and ok) then
						clearLabel(p)
						clearChams(p)
					else
						local o = labels[p]
						if not o or o.char ~= char or not o.bb.Parent then
							buildLabel(p, char)
							o = labels[p]
						end
						if o then
							o.label.Visible = not E.box
							if not E.box then
								local txt = labelText(p, char, hum)
								if o.last ~= txt then
									o.last = txt
									o.label.Text = txt
								end
							end
						end
						if E.chams then
							local h = chams[p]
							if not h or not h.Parent or h.Adornee ~= char then
								clearChams(p)
								h = make("Highlight", { Adornee = char, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop }, guiParent())
								chams[p] = h
							end
							h.FillColor, h.OutlineColor = E.color, E.color
							h.FillTransparency, h.OutlineTransparency = 0.35, 0
						else
							clearChams(p)
						end
					end
				end
			end)
		end
	end)

	connect(RunService.RenderStepped, function()
		pcall(updateBoxes)
	end)

	local function clearAll()
		for p in pairs(labels) do clearLabel(p) end
		for p in pairs(chams) do clearChams(p) end
		for p in pairs(boxes) do clearBox(p) end
	end
	Hub.ClearEsp = clearAll
	connect(Players.PlayerRemoving, function(p)
		clearLabel(p)
		clearChams(p)
		clearBox(p)
	end)
	Hub.OnUnload(function()
		E.enabled = false
		clearAll()
	end)
end

