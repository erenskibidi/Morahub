				click()
			end
		end
	end)

	function Hub.Rejoin()
		Hub.Notify({ Title = "Rejoin", Content = "Đang vào lại server...", Duration = 3 })
		pcall(function()
			if #Players:GetPlayers() <= 1 then
				TeleportService:Teleport(game.PlaceId, LocalPlayer)
			else
				TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
			end
		end)
	end

	function Hub.ServerHop()
		Hub.Notify({ Title = "Server Hop", Content = "Đang tìm server khác...", Duration = 3 })
		task.spawn(function()
			local ok, res = pcall(function()
				local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
				return HttpService:JSONDecode(game:HttpGet(url))
			end)
			if not ok or type(res) ~= "table" or type(res.data) ~= "table" then
				Hub.Notify({ Title = "Server Hop", Content = "Không lấy được danh sách server.", Color = THEME.danger })
				return
			end
			local candidates = {}
			for _, s in ipairs(res.data) do
				if s.id ~= game.JobId and s.playing and s.maxPlayers and s.playing < s.maxPlayers - 1 then
					table.insert(candidates, s.id)
				end
			end
			if #candidates == 0 then
				Hub.Notify({ Title = "Server Hop", Content = "Không có server phù hợp.", Color = THEME.danger })
				return
			end
			pcall(function()
				TeleportService:TeleportToPlaceInstance(game.PlaceId, candidates[math.random(1, #candidates)], LocalPlayer)
			end)
		end)
	end

	function Hub.CopyJobId()
		if setclipboard then
			setclipboard(game.JobId)
			Hub.Notify({ Title = "Đã chép", Content = "JobId đã được chép.", Duration = 2 })
		end
	end

	function Hub.ResetCharacter()
		local _, hum = getRootHum()
		if hum then
			hum.Health = 0
		end
	end

	function Hub.ScanGunValues()
		if not getgc then
			Hub.Notify({ Title = "Dò giá trị", Content = "Executor không hỗ trợ getgc.", Color = THEME.danger })
			return
		end
		local words = { "recoil", "spread", "kick", "sway", "shake", "punch", "bloom", "accuracy" }
		local found, any = {}, false
		local ok, objects = pcall(function() return getgc(true) end)
		if not ok then
			return
		end
		for _, obj in ipairs(objects) do
			if type(obj) == "table" then
				pcall(function()
					for key, value in pairs(obj) do
						if type(key) == "string" and type(value) == "number" then
							local lk = key:lower()
							for _, w in ipairs(words) do
								if lk:find(w) then
									local e = found[key] or { count = 0, sample = value }
									e.count += 1
									found[key] = e
									break
								end
							end
						end
					end
				end)
			end
		end
		print("========== [LuciferHub] Giá trị liên quan đến súng ==========")
		for key, e in pairs(found) do
			any = true
			print(("%s | mẫu = %s | số bảng = %d"):format(key, tostring(e.sample), e.count))
		end
		if not any then
			print("Không tìm thấy gì. Hãy cầm súng lên rồi bấm lại.")
		end
		print("=============================================================")
		Hub.Notify({ Title = "Dò giá trị", Content = "Đã in kết quả ra console (F9).", Duration = 3 })
	end

	Hub.OnUnload(function()
		Hub.SetAntiAfk(false)
	end)
end

