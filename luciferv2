local Config = { Folder = "LuciferHub", Ext = ".json" }

local function encodeValue(v)
	local t = typeof(v)
	if t == "Color3" then
		return { __t = "c", r = v.R, g = v.G, b = v.B }
	elseif t == "EnumItem" then
		return tostring(v.Name)
	end
	return v
end

local function decodeValue(v)
	if type(v) == "table" and v.__t == "c" then
		return Color3.new(v.r, v.g, v.b)
	end
	return v
end

local function cfgPath(name)
	return Config.Folder .. "/" .. name .. Config.Ext
end

function Config.Ready()
	return writefile and readfile and isfile and makefolder and isfolder
end

function Config.Init()
	if not Config.Ready() then
		return false
	end
	pcall(function()
		if not isfolder(Config.Folder) then
			makefolder(Config.Folder)
		end
	end)
	return true
end

function Config.Save(name)
	if not Config.Init() then
		return false, "Executor không hỗ trợ ghi file"
	end
	local out = {}
	for flag, v in pairs(Hub.Flags) do
		if not Hub.NoSave or not Hub.NoSave[flag] then
			out[flag] = encodeValue(v)
		end
	end
	local ok, err = pcall(function()
		writefile(cfgPath(name), HttpService:JSONEncode(out))
	end)
	return ok, err
end

function Config.Load(name)
	if not Config.Init() then
		return false, "Executor không hỗ trợ đọc file"
	end
	if not isfile(cfgPath(name)) then
		return false, "Không tìm thấy cấu hình '" .. name .. "'"
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(cfgPath(name)))
	end)
	if not ok or type(data) ~= "table" then
		return false, "File cấu hình bị lỗi"
	end
	local n = 0
	for flag, v in pairs(data) do
		local setter = Hub.Setters[flag]
		if setter and not (Hub.NoSave and Hub.NoSave[flag]) then
			pcall(setter, decodeValue(v))
			n += 1
		end
	end
	return true, n
end

function Config.List()
	local names = {}
	if not Config.Init() or not listfiles then
		return names
	end
	pcall(function()
		for _, path in ipairs(listfiles(Config.Folder)) do
			local fname = path:match("([^/\\]+)%.json$")
			if fname then
				table.insert(names, fname)
			end
		end
	end)
	table.sort(names)
	return names
end

function Config.Delete(name)
	if Config.Init() and delfile and isfile(cfgPath(name)) then
		return pcall(delfile, cfgPath(name))
	end
	return false
end

Hub.NoSave = { ConfigName = true, ConfigList = true, PlayerList = true }
