function UILib.CheckKey(ks)
	local gui = make("ScreenGui", {
		Name = "LuciferKey", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 1000, IgnoreGuiInset = true,
	})
	protectGui(gui)
	gui.Parent = guiParent()
	Hub.Maid:Give(gui)

	local keys = ks.Key or {}
	local function valid(k)
		return table.find(keys, k) ~= nil
	end

	local saved
	pcall(function()
		local f = (ks.FileName or "LuciferKey") .. ".txt"
		if ks.SaveKey and isfile and isfile(f) then
			saved = readfile(f)
		end
	end)
	if saved and valid(saved) then
		gui:Destroy()
		return true
	end

	local passed = false
	local gate = make("Frame", {
		Size = UDim2.fromOffset(340, 270),
		Position = UDim2.new(0.5, -170, 0.5, -135),
		BackgroundColor3 = THEME.bg,
		BorderSizePixel = 0,
	}, gui)
	corner(gate, 12)
	local gs = make("UIStroke", { Color = THEME.accent, Thickness = 1, Transparency = 0.4 }, gate)
	onAccent(function(col)
		gs.Color = col
	end)

	local img = make("ImageLabel", {
		BackgroundColor3 = THEME.side, Image = loadLogo(), ScaleType = Enum.ScaleType.Crop,
		Size = UDim2.fromOffset(84, 84), Position = UDim2.new(0.5, -42, 0, 18),
	}, gate)
	corner(img, 42)

	local title = label(gate, ks.Title or "Key", 18, THEME.text, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
	title.Position = UDim2.new(0, 0, 0, 110)
	title.Size = UDim2.new(1, 0, 0, 24)
	local note = label(gate, ks.Note or "", 12, THEME.sub, Enum.Font.Gotham, Enum.TextXAlignment.Center)
	note.Position = UDim2.new(0, 16, 0, 136)
	note.Size = UDim2.new(1, -32, 0, 30)
	note.TextWrapped = true

	local box = make("TextBox", {
		BackgroundColor3 = THEME.card, BorderSizePixel = 0, PlaceholderText = "Nhập key...",
		PlaceholderColor3 = THEME.sub, Text = "", TextColor3 = THEME.text, Font = Enum.Font.Gotham,
		TextSize = 13, ClearTextOnFocus = false, Size = UDim2.new(1, -48, 0, 34), Position = UDim2.new(0, 24, 0, 174),
	}, gate)
	corner(box, 6)

	local err = label(gate, "", 12, THEME.danger, Enum.Font.Gotham, Enum.TextXAlignment.Center)
	err.Position = UDim2.new(0, 0, 0, 212)
	err.Size = UDim2.new(1, 0, 0, 16)

	local ok = make("TextButton", {
		Text = "Xác nhận", AutoButtonColor = false, BackgroundColor3 = THEME.accent, BorderSizePixel = 0,
		Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(1, -48, 0, 32), Position = UDim2.new(0, 24, 0, 230),
	}, gate)
	corner(ok, 6)

	local function submit()
		local k = box.Text
		if valid(k) then
			pcall(function()
				if ks.SaveKey and writefile then
					writefile((ks.FileName or "LuciferKey") .. ".txt", k)
				end
			end)
			passed = true
		else
			err.Text = "Key sai, thử lại."
		end
	end
	ok.MouseButton1Click:Connect(submit)
	box.FocusLost:Connect(function(enter)
		if enter then
			submit()
		end
	end)
	makeDraggable(gate, gate)

	repeat
		task.wait(0.1)
	until passed or Hub.Unloaded
	gate:Destroy()
	gui:Destroy()
	return passed
end

