			b.BackgroundColor3 = on and THEME.accent or THEME.card2
		end
	end

	local function resize()
		local h = open and (headH + #options * (rowH - 2 + 2) + 8) or headH
		tween(c, 0.18, { Size = UDim2.new(1, 0, 0, h) })
	end

	local function value()
		if multi then
			return selectedList()
		end
		return current
	end

	local function fire()
		if opt.Flag then Hub.Flags[opt.Flag] = value() end
		safe(opt.Callback, value())
	end

	local function build()
		for _, b in pairs(buttons) do
			b:Destroy()
		end
		buttons = {}
		for i, optName in ipairs(options) do
			local b = make("TextButton", {
				Text = tostring(optName),
				AutoButtonColor = false,
				BackgroundColor3 = THEME.card2,
				BorderSizePixel = 0,
				Font = Enum.Font.Gotham,
				TextSize = 12,
				TextColor3 = THEME.text,
				Size = UDim2.new(1, 0, 0, rowH - 2),
				LayoutOrder = i,
			}, list)
			corner(b, 5)
			buttons[optName] = b
			connect(b.MouseButton1Click, function()
				if multi then
					current[optName] = not current[optName] or nil
				else
					current = optName
					open = false
					resize()
				end
				renderHead()
				renderButtons()
				fire()
			end)
		end
		list.Size = UDim2.new(1, -12, 0, #options * rowH)
		renderHead()
		renderButtons()
	end
	build()
	onAccent(renderButtons)

	connect(head.MouseButton1Click, function()
		open = not open
		resize()
	end)

	local obj = {}
	function obj:Set(v)
		if multi then
			current = {}
			for _, x in ipairs(type(v) == "table" and v or {}) do
				current[x] = true
			end
		else
			current = v
		end
		renderHead()
		renderButtons()
		fire()
	end
	function obj:SetOptions(newOptions, keep)
		options = newOptions
		if not multi and not (keep and table.find(options, current)) then
			current = options[1]
		end
		build()
		if open then
			resize()
		end
	end
	function obj:Get()
		return value()
	end

	registerFlag(opt.Flag, value(), function(v)
		obj:Set(v)
	end)
	task.spawn(safe, opt.Callback, value())
	return obj
end

