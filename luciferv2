-- ===================== MAID =====================
local Maid = {}
Maid.__index = Maid

function Maid.new()
	return setmetatable({ tasks = {} }, Maid)
end

function Maid:Give(item)
	table.insert(self.tasks, item)
	return item
end

function Maid:Clean()
	for _, t in ipairs(self.tasks) do
		local ty = typeof(t)
		if ty == "RBXScriptConnection" then
			pcall(function() t:Disconnect() end)
		elseif ty == "Instance" then
			pcall(function() t:Destroy() end)
		elseif ty == "function" then
			pcall(t)
		else
			pcall(function()
				if t.Remove then
					t:Remove()
				elseif t.Destroy then
					t:Destroy()
				end
			end)
		end
	end
	self.tasks = {}
end

