Hub.S.vis = {
	fullbright = false, nofog = false, fov = 70, fovEnabled = false, clockEnabled = false, clock = 12,
	noShadows = false, fps = false, crosshair = false, crossSize = 8, crossColor = Color3.fromRGB(0, 255, 120),
	invisible = false,
}

do
	local V = Hub.S.vis
	local orig: any = {}

	local function saveOrig()
		if orig.saved then
			return
		end
		orig = {
			saved = true, Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime, Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient, FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart,
			GlobalShadows = Lighting.GlobalShadows,
		}
	end

	connect(RunService.RenderStepped, function()
		local cam = workspace.CurrentCamera
		if V.fovEnabled and cam then
			cam.FieldOfView = V.fov
		end
		if V.fullbright then
			saveOrig()
			Lighting.Brightness = 2
			Lighting.Ambient = Color3.new(1, 1, 1)
			Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
		end
		if V.nofog then
			saveOrig()
			Lighting.FogEnd = 9e9
			Lighting.FogStart = 9e9
		end
		if V.clockEnabled then
			saveOrig()
			Lighting.ClockTime = V.clock
		end
		if V.noShadows then
			saveOrig()
			Lighting.GlobalShadows = false
		end
	end)

	function Hub.RestoreLighting()
		if not orig.saved then
			return
		end
		if not V.fullbright then
			Lighting.Brightness = orig.Brightness
			Lighting.Ambient = orig.Ambient
			Lighting.OutdoorAmbient = orig.OutdoorAmbient
		end
		if not V.nofog then
			Lighting.FogEnd = orig.FogEnd
			Lighting.FogStart = orig.FogStart
		end
		if not V.clockEnabled then
			Lighting.ClockTime = orig.ClockTime
		end
		if not V.noShadows then
			Lighting.GlobalShadows = orig.GlobalShadows
		end
	end

	function Hub.SetFps(on)
		local was = V.fps
		V.fps = on
		if not on and not was then
			return
		end
		if on then
			pcall(function()
				Lighting.GlobalShadows = false
				settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
				local terrain = workspace:FindFirstChildOfClass("Terrain")
				if terrain then
					terrain.WaterWaveSize, terrain.WaterWaveSpeed, terrain.WaterReflectance, terrain.WaterTransparency = 0, 0, 0, 0
				end
				for _, v in ipairs(workspace:GetDescendants()) do
					if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
						v.Enabled = false
					elseif v:IsA("BasePart") then
						v.Material = Enum.Material.SmoothPlastic
						v.Reflectance = 0
					end
				end
			end)
		else
			pcall(function()
				Lighting.GlobalShadows = orig.saved and orig.GlobalShadows or true
				settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
			end)
		end
	end

	local function applyInvisible()
		local char = LocalPlayer.Character
		if not char then
			return
		end
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then
				d.LocalTransparencyModifier = V.invisible and 1 or 0
			end
		end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.DisplayDistanceType = V.invisible and Enum.HumanoidDisplayDistanceType.None or Enum.HumanoidDisplayDistanceType.Viewer
		end
	end
	Hub.ApplyInvisible = applyInvisible
	task.spawn(function()
		while not Hub.Unloaded do
			task.wait(1)
			if V.invisible then
				pcall(applyInvisible)
			end
		end
	end)
	connect(LocalPlayer.CharacterAdded, function()
		task.wait(0.5)
		pcall(applyInvisible)
		if V.fps then
			Hub.SetFps(true)
		end
	end)

	local lines = {}
	pcall(function()
		if Drawing then
			for i = 1, 4 do
				local l = Drawing.new("Line")
				l.Thickness = 2
				l.Visible = false
				Hub.Maid:Give(l)
				lines[i] = l
			end
		end
	end)
	connect(RunService.RenderStepped, function()
		if #lines == 0 then
			return
		end
		local cam = workspace.CurrentCamera
		local show = V.crosshair and cam ~= nil
		for _, l in ipairs(lines) do
			l.Visible = show
		end
		if show then
			local c = cam.ViewportSize / 2
			local s, gap = V.crossSize, 3
			lines[1].From, lines[1].To = Vector2.new(c.X - gap - s, c.Y), Vector2.new(c.X - gap, c.Y)
			lines[2].From, lines[2].To = Vector2.new(c.X + gap, c.Y), Vector2.new(c.X + gap + s, c.Y)
			lines[3].From, lines[3].To = Vector2.new(c.X, c.Y - gap - s), Vector2.new(c.X, c.Y - gap)
			lines[4].From, lines[4].To = Vector2.new(c.X, c.Y + gap), Vector2.new(c.X, c.Y + gap + s)
			for _, l in ipairs(lines) do
				l.Color = V.crossColor
			end
		end
	end)

	Hub.OnUnload(function()
		V.fullbright, V.nofog, V.clockEnabled, V.noShadows, V.fovEnabled, V.invisible, V.crosshair = false, false, false, false, false, false, false
		pcall(Hub.RestoreLighting)
		pcall(applyInvisible)
		if V.fps then
			Hub.SetFps(false)
		end
	end)
end

