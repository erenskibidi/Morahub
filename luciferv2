	name.Position = UDim2.new(0, 12, 0, 0)
	name.Size = UDim2.new(1, -120, 1, 0)

	local btn = make("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = THEME.card2,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = THEME.accent,
		Size = UDim2.fromOffset(90, 24),
		Position = UDim2.new(1, -102, 0.5, -12),
		Text = key,
	}, c)
	corner(btn, 5)
	onAccent(function(col)
		btn.TextColor3 = col
	end)

	local entry = { key = key, listening = false, onPress = opt.OnPress }
	table.insert(Hub.Keybinds, entry)

	local obj = {}
	local function set(k)
		key = k
		entry.key = k
		btn.Text = k
		if opt.Flag then Hub.Flags[opt.Flag] = k end
		safe(opt.Callback, k)
	end
	function obj:Set(k)
		set(tostring(k))
	end
	function obj:Get()
		return key
	end

	connect(btn.MouseButton1Click, function()
		listening = true
		Hub.Listening = true
		btn.Text = "..."
	end)

	connect(UserInputService.InputBegan, function(input)
		if not listening then
			return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			listening = false
			task.defer(function()
				Hub.Listening = false
			end)
			if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
				set("None")
			else
				set(input.KeyCode.Name)
			end
		end
	end)

	registerFlag(opt.Flag, key, function(v)
		set(tostring(v))
	end)
	task.spawn(safe, opt.Callback, key)
	return obj
end

