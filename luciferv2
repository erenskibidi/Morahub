-- ============================================================
-- ADDON: AIMBOT + WALLBANG (ĐÃ FIX) + AUTO FIRE
-- Bọc trong do ... end để không vượt giới hạn 200 biến local của Lua
-- ============================================================
do
	local notify = function(title, content, dur)
		pcall(Hub.Notify, { Title = title, Content = content, Duration = dur or 3 })
	end

	local function myParts()
		local char = LocalPlayer.Character
		if not char then
			return nil, nil, nil
		end
		return char, char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
	end

	-- ===================== AIMBOT =====================
	local AB = {
		enabled = false,
		hold = "Chuột phải",
		part = "Head",
		mode = "Gần tâm",
		fov = 150,
		smooth = 4,
		predict = 0,
		maxDist = 1500,
		team = false,
		wall = false,
		sticky = true,
		showFov = false,
		locked = nil,
	}
	Hub.S.aimbot = AB

	local fovCircle
	pcall(function()
		if Drawing then
			fovCircle = Drawing.new("Circle")
			fovCircle.Thickness = 1
			fovCircle.NumSides = 64
			fovCircle.Filled = false
			fovCircle.Color = Color3.fromRGB(255, 255, 255)
			fovCircle.Visible = false
			Hub.Maid:Give(fovCircle)
		end
	end)

	local function aimCenter()
		local cam = workspace.CurrentCamera
		if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter and cam then
			return cam.ViewportSize / 2
		end
		return UserInputService:GetMouseLocation()
	end

	local function pickPart(char)
		return char:FindFirstChild(AB.part) or char:FindFirstChild("HumanoidRootPart")
	end

	local function visible(part)
		local cam = workspace.CurrentCamera
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { LocalPlayer.Character }
		local hit = workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, params)
		return not hit or hit.Instance:IsDescendantOf(part.Parent)
	end

	local function validTarget(part)
		if not part or not part.Parent then
			return false
		end
		local hum = part.Parent:FindFirstChildOfClass("Humanoid")
		return hum ~= nil and hum.Health > 0
	end

	local function getTarget()
		local cam = workspace.CurrentCamera
		if not cam then
			return nil
		end
		local center = aimCenter()
		local _, myRoot = myParts()
		local best, bestScore = nil, math.huge

		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and not (AB.team and sameTeam(p)) then
				local char = p.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local part = char and pickPart(char)
				if part and hum and hum.Health > 0 then
					local sp, on = cam:WorldToViewportPoint(part.Position)
					if on and sp.Z > 0 then
						local d2 = (Vector2.new(sp.X, sp.Y) - center).Magnitude
						local d3 = myRoot and (part.Position - myRoot.Position).Magnitude or 0
						if d2 <= AB.fov and d3 <= AB.maxDist and (not AB.wall or visible(part)) then
							local score = (AB.mode == "Gần tâm") and d2 or d3
							if score < bestScore then
								best, bestScore = part, score
							end
						end
					end
				end
			end
		end
		return best
	end

	local function isHolding()
		local h = AB.hold
		if h == "Luôn bật" then
			return true
		elseif h == "Chuột phải" then
			return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
		elseif h == "Chuột trái" then
			return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
		end
		return false
	end

	RunService:BindToRenderStep("LuciferAimbot", Enum.RenderPriority.Camera.Value + 2, function(dt)
		if fovCircle then
			fovCircle.Visible = AB.enabled and AB.showFov
			fovCircle.Radius = AB.fov
			fovCircle.Position = aimCenter()
		end

		if not AB.enabled or (Hub.S.farm and Hub.S.farm.running) then
			AB.locked = nil
			return
		end
		if Hub.Gui and Hub.Gui.Enabled and UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
			AB.locked = nil
			return
		end
		if not isHolding() then
			AB.locked = nil
			return
		end

		local part
		if AB.sticky and validTarget(AB.locked) then
			part = AB.locked
		else
			part = getTarget()
		end
		AB.locked = part
		if not part then
			return
		end

		local cam = workspace.CurrentCamera
		local pos = part.Position
		if AB.predict > 0 then
			pos = pos + part.AssemblyLinearVelocity * AB.predict
		end
		local goal = CFrame.lookAt(cam.CFrame.Position, pos)
		local alpha = AB.smooth <= 1 and 1 or math.clamp(dt * 60 / AB.smooth, 0, 1)
		cam.CFrame = cam.CFrame:Lerp(goal, alpha)
	end)

	-- ===================== WALLBANG (ĐÃ FIX) =====================
	local WB = {
		enabled = false,
		sphere = false,
		installed = false,
		mouseDown = false,
		tool = false,
		radius = 8,
		nextUpdate = 0,
		list = {},    -- character địch (cho whitelist)
		points = {},  -- vị trí địch đã chép sẵn thành Vector3 (hook chỉ đọc cái này)
		stats = {} :: { [string]: number },
		params = RaycastParams.new(),
	}
	WB.params.FilterType = Enum.RaycastFilterType.Include
	Hub.S.wallbang = WB

	connect(UserInputService.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			WB.mouseDown = true
		end
	end)
	connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			WB.mouseDown = false
		end
	end)

	-- Cập nhật mỗi frame, NGOÀI hook
	connect(RunService.Heartbeat, function()
		if not WB.enabled then
			return
		end
		local nowT = os.clock()
		if nowT - WB.nextUpdate < 0.03 then
			return
		end
		WB.nextUpdate = nowT
		local char = LocalPlayer.Character
		WB.tool = char ~= nil and char:FindFirstChildOfClass("Tool") ~= nil

		local list, points = {}, {}
		for _, p in ipairs(Players:GetPlayers()) do
			local c = p.Character
			if p ~= LocalPlayer and c and not (AB.team and sameTeam(p)) then
				table.insert(list, c)
				local root = c:FindFirstChild("HumanoidRootPart")
				local head = c:FindFirstChild("Head")
				if root then
					table.insert(points, root.Position)
				end
				if head then
					table.insert(points, head.Position)
				end
			end
		end
		WB.list, WB.points = list, points
		WB.params.FilterDescendantsInstances = list
	end)

	-- Chỉ tính trên số / Vector3, KHÔNG đụng vào Instance trong hook
	local function rayNearEnemy(origin, dir)
		local len = dir.Magnitude
		if len < 0.001 then
			return false
		end
		local ux, uy, uz = dir.X / len, dir.Y / len, dir.Z / len
		local r2 = WB.radius * WB.radius
		for _, p in ipairs(WB.points) do
			local vx, vy, vz = p.X - origin.X, p.Y - origin.Y, p.Z - origin.Z
			local t = vx * ux + vy * uy + vz * uz
			if t < 0 then
				t = 0
			elseif t > len then
				t = len
			end
			local dx, dy, dz = vx - ux * t, vy - uy * t, vz - uz * t
			if dx * dx + dy * dy + dz * dz < r2 then
				return true
			end
		end
		return false
	end

	local function installWallbang()
		if WB.installed then
			return true
		end
		if not (hookmetamethod and getnamecallmethod and setnamecallmethod and checkcaller and newcclosure) then
			notify("Wallbang", "Executor không hỗ trợ hookmetamethod / setnamecallmethod.", 4)
			return false
		end

		local old
		local ok, err = pcall(function()
			old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
				local method = getnamecallmethod()

				if WB.enabled and self == workspace and (WB.mouseDown or WB.tool) and not checkcaller() then
					if method == "Raycast" then
						local origin, direction = ...
						if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" and rayNearEnemy(origin, direction) then
							WB.stats.Raycast = (WB.stats.Raycast or 0) + 1
							setnamecallmethod(method)
							return old(self, origin, direction, WB.params)
						end
					elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
						local ray = ...
						if typeof(ray) == "Ray" and rayNearEnemy(ray.Origin, ray.Direction) then
							WB.stats.FindPartOnRay = (WB.stats.FindPartOnRay or 0) + 1
							setnamecallmethod("FindPartOnRayWithWhitelist")
							return old(self, ray, WB.list)
						end
					elseif WB.sphere and (method == "Spherecast" or method == "Blockcast") then
						local o, s, d = ...
						local origin = typeof(o) == "CFrame" and o.Position or o
						if typeof(origin) == "Vector3" and typeof(d) == "Vector3" and rayNearEnemy(origin, d) then
							WB.stats[method] = (WB.stats[method] or 0) + 1
							setnamecallmethod(method)
							return old(self, o, s, d, WB.params)
						end
					end
					-- Không can thiệp: trả lại đúng tên method trước khi gọi hàm gốc
					setnamecallmethod(method)
				end

				return old(self, ...)
			end))
		end)

		if not ok then
			notify("Wallbang", "Lỗi cài hook: " .. tostring(err), 5)
			return false
		end
		WB.installed = true
		return true
	end

	-- ===================== AUTO FIRE =====================
	local AF = { enabled = false, cps = 12, last = 0 }
	Hub.S.autofire = AF

	connect(RunService.Heartbeat, function()
		if not AF.enabled then
			return
		end
		if os.clock() - AF.last < 1 / AF.cps then
			return
		end
		if Hub.Gui and Hub.Gui.Enabled then
			return
		end
		if UserInputService:GetFocusedTextBox() then
			return
		end
		if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
			return
		end
		local char = LocalPlayer.Character
		if not (char and char:FindFirstChildOfClass("Tool")) then
			return
		end
		AF.last = os.clock()
		local loc = UserInputService:GetMouseLocation()
		task.spawn(function()
			pcall(function()
				VirtualInputManager:SendMouseButtonEvent(loc.X, loc.Y, 0, true, game, 0)
				task.wait(0.01)
				VirtualInputManager:SendMouseButtonEvent(loc.X, loc.Y, 0, false, game, 0)
			end)
		end)
	end)

