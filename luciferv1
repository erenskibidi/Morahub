-- Bật tính năng trong menu, rồi GIỮ SHIFT TRÁI để chạy nhanh, thả ra thì về tốc độ cũ
local speed = {
	enabled = false,
	value = 50,
	orig = 16,
	applied = false,
}

-- Không dùng WalkSpeed nữa (game Outside hay reset/khóa giá trị này).
-- Thay vào đó đẩy nhân vật tiến thêm theo hướng đang đi bằng CFrame mỗi frame.
RunService.Heartbeat:Connect(function(dt)
	local root, hum = getCharacterParts()
	if not root or not hum or hum.Health <= 0 then
		return
	end
	if not speed.enabled or state.running or hum.SeatPart ~= nil then
		return -- ngồi trên xe thì không đẩy CFrame (sẽ làm xe bay mất)
	end
	if not UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:GetFocusedTextBox() then
		return
	end
	local dir = hum.MoveDirection
	if dir.Magnitude < 0.1 then
		return
	end
	local extra = math.max(speed.value - hum.WalkSpeed, 0)
	root.CFrame = root.CFrame + dir.Unit * extra * dt
end)

local function setSpeed(on)
	speed.enabled = on
end

-- ==================== QUAY NGƯỜI (SPIN) ====================
-- Nhân vật xoay liên tục quanh trục dọc nên người khác khó ngắm trúng.
local spin = {
	enabled = false,
	speed = 8, -- số vòng quay mỗi giây
	active = false,
}

RunService.Heartbeat:Connect(function(dt)
	local root, hum = getCharacterParts()
	if not root or not hum or hum.Health <= 0 then
		spin.active = false
		return
	end
	-- Đang ngồi trên xe / ghế thì KHÔNG quay, vì xoay nhân vật sẽ hất tung cả chiếc xe
	local seated = hum.SeatPart ~= nil
	if spin.enabled and not state.running and not seated then
		if not spin.active then
			spin.active = true
			hum.AutoRotate = false -- không cho game xoay nhân vật lại theo hướng đi
		end
		root.CFrame = root.CFrame * CFrame.Angles(0, spin.speed * 2 * math.pi * dt, 0)
	elseif spin.active then
		spin.active = false
		hum.AutoRotate = true
	end
end)

