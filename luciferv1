local accentBinders = {}
local function onAccent(fn)
	table.insert(accentBinders, fn)
	fn(THEME.accent)
end
local function setAccent(c)
	THEME.accent = c
	for _, fn in ipairs(accentBinders) do
		pcall(fn, c)
	end
end

local function safe(fn, ...)
	if type(fn) ~= "function" then
		return
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[UI] " .. tostring(err))
	end
end

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	if parent then
		o.Parent = parent
	end
	return o
end

local function round(o, r)
	make("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o)
end

local function tween(o, t, props)
	TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

local function makeText(parent, text, size, color, font, xalign)
	return make("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size,
		TextColor3 = color,
		Font = font or Enum.Font.GothamMedium,
		TextXAlignment = xalign or Enum.TextXAlignment.Left,
	}, parent)
end

local function makeDraggable(handle, target)
	local dragging, startInput, startPos = false, nil, nil
	handle.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			startInput = input.Position
			startPos = target.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and isMove(input) then
			local d = input.Position - startInput
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if isPress(input) then
			dragging = false
		end
	end)
end

local function bindDrag(hit, onAlpha)
	local active = false
	local function update(x)
		local a = math.clamp((x - hit.AbsolutePosition.X) / math.max(hit.AbsoluteSize.X, 1), 0, 1)
		onAlpha(a)
	end
	hit.InputBegan:Connect(function(input)
		if isPress(input) then
			active = true
			update(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if active and isMove(input) then
			update(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if isPress(input) then
			active = false
		end
	end)
end

local function screenPos(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		local inset = GuiService:GetGuiInset()
		return Vector2.new(input.Position.X, input.Position.Y + inset.Y)
	end
	return UserInputService:GetMouseLocation()
end

local function bindDragXY(hit, onAlpha)
	local active = false
	local function update(input)
		local pos = screenPos(input)
		local ax = math.clamp((pos.X - hit.AbsolutePosition.X) / math.max(hit.AbsoluteSize.X, 1), 0, 1)
		local ay = math.clamp((pos.Y - hit.AbsolutePosition.Y) / math.max(hit.AbsoluteSize.Y, 1), 0, 1)
		onAlpha(ax, ay)
	end
	hit.InputBegan:Connect(function(input)
		if isPress(input) then
			active = true
			update(input)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if active and isMove(input) then
			update(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if isPress(input) then
			active = false
		end
	end)
end

-- base64 (dùng hàm của executor nếu có, không thì tự giải mã)
local B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function b64decode(data)
	if crypt and crypt.base64decode then
		local ok, res = pcall(crypt.base64decode, data)
		if ok and res then
			return res
		end
	end
	if base64_decode then
		local ok, res = pcall(base64_decode, data)
		if ok and res then
			return res
		end
	end
	if base64decode then
		local ok, res = pcall(base64decode, data)
		if ok and res then
			return res
		end
	end
	data = data:gsub("[^" .. B64_CHARS .. "=]", "")
	return (data:gsub(".", function(x)
		if x == "=" then
			return ""
		end
		local r, f = "", (B64_CHARS:find(x, 1, true) - 1)
		for i = 6, 1, -1 do
			r = r .. (f % 2 ^ i - f % 2 ^ (i - 1) > 0 and "1" or "0")
		end
		return r
	end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(x)
		if #x ~= 8 then
			return ""
		end
		local c = 0
		for i = 1, 8 do
			c = c + (x:sub(i, i) == "1" and 2 ^ (8 - i) or 0)
		end
		return string.char(c)
	end))
end

local logoCache = nil
local function loadLogo()
	if logoCache then
		return logoCache
	end
	local ok, asset = pcall(function()
		local data
		if LOGO_URL ~= "" then
			data = game:HttpGet(LOGO_URL)
		else
			data = b64decode(LOGO_B64)
		end
		writefile("lucifer_logo_v2.jpg", data)
		return getcustomasset("lucifer_logo_v2.jpg")
	end)
	if ok and asset then
		logoCache = asset
		return asset
	end
	return ""
end

