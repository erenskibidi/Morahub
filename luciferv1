-- Người có chữ "rookie" (tên, team, attribute, leaderstats, hoặc thẻ chữ trên đầu) sẽ hiện là "newbie"
local function hasRookieText(v)
	return type(v) == "string" and v:lower():find("rookie", 1, true) ~= nil
end

local function computeRookie(p, char)
	if hasRookieText(p.DisplayName) or hasRookieText(p.Name) then
		return true
	end
	if p.Team and hasRookieText(p.Team.Name) then
		return true
	end
	for _, v in pairs(p:GetAttributes()) do
		if hasRookieText(v) then
			return true
		end
	end
	local ls = p:FindFirstChild("leaderstats")
	if ls then
		for _, child in ipairs(ls:GetChildren()) do
			if hasRookieText(child.Name) then
				return true
			end
			if child:IsA("ValueBase") then
				local ok, val = pcall(function()
					return child.Value
				end)
				if ok and hasRookieText(val) then
					return true
				end
			end
		end
	end
	if char then
		for _, v in pairs(char:GetAttributes()) do
			if hasRookieText(v) then
				return true
			end
		end
		for _, d in ipairs(char:GetDescendants()) do
			if (d:IsA("TextLabel") or d:IsA("TextButton")) and hasRookieText(d.Text) then
				return true
			end
		end
	end
	return false
end

local rookieCache = setmetatable({}, { __mode = "k" })

local function isRookie(p, char)
	local c = rookieCache[p]
	local now = os.clock()
	if not c or c.char ~= char or now - c.t > 2 then
		c = { t = now, char = char, v = computeRookie(p, char) }
		rookieCache[p] = c
	end
	return c.v
end

local NEWBIE_COLOR = Color3.fromRGB(70, 255, 110)

local function espName(p, char)
	if isRookie(p, char) then
		return "newbie"
	end
	return p.DisplayName
end

local ARMOR_KEYS = { "armor", "armour", "vest", "kevlar", "shield" }

local function matchArmorName(n)
	n = tostring(n):lower()
	for _, k in ipairs(ARMOR_KEYS) do
		if n:find(k, 1, true) then
			return true
		end
	end
	return false
end

local function computeArmor(p, char, hum)
	local holders = { p, char, hum }
	for _, h in ipairs(holders) do
		if h then
			for k, v in pairs(h:GetAttributes()) do
				if type(v) == "number" and matchArmorName(k) then
					return v
				end
			end
		end
	end
	for _, root in ipairs({ char, p }) do
		if root then
			for _, d in ipairs(root:GetDescendants()) do
				if (d:IsA("NumberValue") or d:IsA("IntValue")) and matchArmorName(d.Name) then
					return d.Value
				end
			end
		end
	end
	return nil
end

local armorCache = setmetatable({}, { __mode = "k" })

local function findArmor(p, char, hum)
	local c = armorCache[p]
	local now = os.clock()
	if not c or c.char ~= char or now - c.t > 1 then
		c = { t = now, char = char, v = computeArmor(p, char, hum) }
		armorCache[p] = c
	end
	return c.v
end

local function rgbStr(c)
	return string.format("rgb(%d,%d,%d)", math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255))
end

local function xmlEscape(t)
	return (tostring(t):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

-- Nhãn trên đầu: dòng 1 = tên (newbie thì to + xanh lá), dòng 2 = máu / giáp
local function espLabelText(p, char, hum)
	local rookie = isRookie(p, char)
	local nameColor = rookie and NEWBIE_COLOR or esp.color
	local nameSize = rookie and esp.newbieSize or esp.textSize
	local text = string.format('<font size="%d" color="%s"><b>%s</b></font>', nameSize, rgbStr(nameColor), xmlEscape(espName(p, char)))

	local parts = {}
	if esp.showHealth and hum then
		local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
		local hc = Color3.fromRGB(255, 70, 70):Lerp(Color3.fromRGB(80, 255, 110), ratio)
		table.insert(parts, string.format('<font color="%s">HP %d</font>', rgbStr(hc), math.floor(hum.Health)))
	end
	if esp.showArmor then
		local armor = findArmor(p, char, hum)
		if armor then
			table.insert(parts, string.format('<font color="rgb(90,170,255)">AR %d</font>', math.floor(armor)))
		end
	end
	if #parts > 0 then
		local subSize = math.max(8, esp.textSize - 4)
		text = text .. string.format('\n<font size="%d">%s</font>', subSize, table.concat(parts, "  "))
	end
	return text
end

local function refreshEsp()
	for _, p in ipairs(Players:GetPlayers()) do
		local ok, char, hum = shouldShowEsp(p)
		if not (esp.enabled and ok) then
			local o = espObjects[p]
			if o then
				pcall(function() o.bb:Destroy() end)
				espObjects[p] = nil
			end
		else
			local o = espObjects[p]
			if not o or o.char ~= char or not o.bb.Parent then
				buildEsp(p, char)
				o = espObjects[p]
			end
			if o then
				o.label.Text = espLabelText(p, char, hum)
				o.label.Visible = not esp.box
			end
		end
	end
end

