function TabMethods:CreateToggle(opt)
	local value = opt.CurrentValue and true or false
	local c = newCard(self, 38)
	local name = makeText(c, opt.Name, 13, THEME.text)
	name.Position = UDim2.new(0, 12, 0, 0)
	name.Size = UDim2.new(1, -70, 1, 0)

	local sw = make("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(38, 20),
		Position = UDim2.new(1, -50, 0.5, -10),
		BackgroundColor3 = THEME.card2,
		BorderSizePixel = 0,
	}, c)
	round(sw, 10)
	local knob = make("Frame", {
		Size = UDim2.fromOffset(14, 14),
		Position = UDim2.new(0, 3, 0.5, -7),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, sw)
	round(knob, 7)

	local function render(animate)
		local pos = value and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
		local col = value and THEME.accent or THEME.card2
		if animate then
			tween(knob, 0.15, { Position = pos })
			tween(sw, 0.15, { BackgroundColor3 = col })
		else
			knob.Position = pos
			sw.BackgroundColor3 = col
		end
	end
	render(false)
	onAccent(function()
		render(false)
	end)

	sw.MouseButton1Click:Connect(function()
		value = not value
		render(true)
		safe(opt.Callback, value)
	end)

	local obj = {}
	function obj:Set(v)
		value = v and true or false
		render(true)
		safe(opt.Callback, value)
	end
	task.spawn(safe, opt.Callback, value)
	return obj
end

function TabMethods:CreateSlider(opt)
	local min, max = opt.Range[1], opt.Range[2]
	local inc = opt.Increment or 1
	local value = math.clamp(opt.CurrentValue or min, min, max)
	local c = newCard(self, 52)

	local name = makeText(c, opt.Name, 13, THEME.text)
	name.Position = UDim2.new(0, 12, 0, 6)
	name.Size = UDim2.new(1, -120, 0, 18)

	local valLabel = makeText(c, "", 12, THEME.sub, Enum.Font.GothamMedium, Enum.TextXAlignment.Right)
	valLabel.Position = UDim2.new(1, -112, 0, 6)
	valLabel.Size = UDim2.new(0, 100, 0, 18)

	local hit = make("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 28),
		Size = UDim2.new(1, -24, 0, 20),
	}, c)
	local bar = make("Frame", {
		BackgroundColor3 = THEME.card2,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0.5, -3),
		Size = UDim2.new(1, 0, 0, 6),
	}, hit)
	round(bar, 3)
	local fill = make("Frame", { BackgroundColor3 = THEME.accent, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0) }, bar)
	round(fill, 3)
	onAccent(function(col)
		fill.BackgroundColor3 = col
	end)

	local function render()
		local a = (max > min) and (value - min) / (max - min) or 0
		fill.Size = UDim2.new(a, 0, 1, 0)
		valLabel.Text = tostring(value) .. (opt.Suffix and (" " .. opt.Suffix) or "")
	end
	render()

	bindDrag(hit, function(a)
		local raw = min + a * (max - min)
		local v = min + math.floor((raw - min) / inc + 0.5) * inc
		v = math.clamp(v, min, max)
		v = tonumber(string.format("%.3f", v))
		if v ~= value then
			value = v
			render()
			safe(opt.Callback, value)
		end
	end)

	local obj = {}
	function obj:Set(v)
		value = math.clamp(v, min, max)
		render()
		safe(opt.Callback, value)
	end
	task.spawn(safe, opt.Callback, value)
	return obj
end

