function UILib:Notify(opt)
	if not self.NotifyHolder then
		return
	end
	local f = make("Frame", {
		BackgroundColor3 = THEME.card,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, self.NotifyHolder)
	round(f, 8)
	local st = make("UIStroke", { Color = THEME.accent, Thickness = 1, Transparency = 0.4 }, f)
	make("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, f)
	make("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, f)
	local t = makeText(f, opt.Title or "", 13, THEME.accent, Enum.Font.GothamBold)
	t.Size = UDim2.new(1, 0, 0, 16)
	t.LayoutOrder = 1
	local b = makeText(f, opt.Content or "", 12, THEME.text, Enum.Font.Gotham)
	b.Size = UDim2.new(1, 0, 0, 0)
